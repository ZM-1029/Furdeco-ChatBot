.tt-step-dot{width:24px;height:24px;border-radius:50%;border:2px solid #d1d1d6;background:white;display:flex;align-items:center;justify-content:center;font-size:9.5px;font-weight:700;color:#8e8e93;transition:all .35s;flex-shrink:0}
.tt-step.done .tt-step-dot{background:var(--tt-primary);border-color:var(--tt-primary);color:white}
.tt-step.active .tt-step-dot{background:white;border-color:var(--tt-primary);color:var(--tt-primary);box-shadow:0 0 0 3px rgba(var(--tt-primary-rgb),.15)}
