        async function fetchOrder(ref,pc){
          state='fetching';const ldr=ldrMsg('Fetching order…');let o;
          try{o=await API.getOrder(ref,pc);}catch(e){ldr.remove();await showErr(e,'lookup');return;}
          ldr.remove();order=o;await showOrder();
        }

        async function pickAction(a){
          action=a;const lbl={confirm:'Confirm Delivery',decline:'Decline Delivery',instructions:'Add Instructions',none:'No action needed'};
          userMsg(lbl[a]);
          if(a==='none'){
            const hasDate=!(order.planned_date==='N/A'||!order.planned_date||String(order.planned_date).trim()==='')&&!(order.planned_slot?.start==='TBC'||order.planned_slot?.start==='N/A');
            if(hasDate)await botMsg(`No problem! Delivery booked for <strong>${fmtDate(order.planned_date)}</strong>, ${fmtSlot(order.planned_slot)}. 🚚`);
            else await botMsg(`No problem! No delivery date is set yet. You can add instructions or choose a preferred day above — we'll be in touch. 🚚`);
            offerNext(600);return;
          }
          /* User has already verified at OTP step; do not re-verify for actions */
          state='processing';
          await botMsg("✅ <strong>Confirmed!</strong> Processing…");
          setTimeout(performAction,700);
        }

        function showVerify(){
          document.querySelectorAll('#tt-vi').forEach(e=>{const r=e.closest('.tt-row');if(r)r.remove();});
          const el=document.createElement('div');el.className='tt-row b';
          el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent"><div class="tt-vcard"><label>Mobile or Email</label><input type="text" id="tt-vi" placeholder="07700900000 or john@example.com" autocomplete="off"><p class="tt-vhint">Must match the details on your order.</p><div class="tt-btns"><button class="tt-btn-primary" onclick="window._ttV()">Confirm →</button><button class="tt-btn-ghost" onclick="window._ttX()">Cancel</button></div></div></div>`;
          msgs.appendChild(el);sd();setTimeout(()=>document.getElementById('tt-vi')?.focus(),300);
        }

        window._ttV=async function(){const val=document.getElementById('tt-vi')?.value?.trim();if(!val)return;document.querySelectorAll('#tt-vi,.tt-btn-primary,.tt-btn-ghost').forEach(e=>e.disabled=true);const masked=val.includes('@@')?val.replace(/(.{2}).*(@@.*)/,'$1••••$2'):val.replace(/(\d{5})\d+(\d{3})/,'$1•••$2');userMsg(masked);const ldr=ldrMsg('Checking details…');try{const fresh=await API.getOrder(pRef,pPc);order=fresh;}catch(e){}ldr.remove();doVerify(val);};
        window._ttX=function(){document.querySelectorAll('#tt-vi,.tt-btn-primary,.tt-btn-ghost').forEach(e=>e.disabled=true);userMsg('Cancel');cancelFlow();};

        async function doVerify(val){
          if(!verifyIdentity(val,order)){await botMsg("Doesn't match our records. ❌ Try again.");qrs([{label:'🔄 Try Again',fn:()=>{state='verify';showVerify();}},{label:'✕ Cancel',fn:()=>{dQR();userMsg('Cancel');cancelFlow();},cls:'grey'},{label:'👤 Talk to a Human',fn:()=>{dQR();userMsg('Talk to a human');humanHandoff();}}],400);return;}
          state='processing';await botMsg("✅ <strong>Confirmed!</strong> Processing…");setTimeout(performAction,700);
        }

        async function performAction(){
          const ref=order.carrier_reference;const ldr=ldrMsg('Sending update…');
          try{
            if(action==='confirm'){await API.confirmOrder(ref);await API.addNote(ref,`Confirmed via Ask Frankie — ${new Date().toLocaleString('en-GB')}`);ldr.remove();state='done';await botMsg(`🎉 <strong>Delivery Confirmed!</strong><br><strong>${fmtDate(order.planned_date)}</strong>, ${fmtSlot(order.planned_slot)}.`);await addEl(buildSum('confirm',`${fmtDate(order.planned_date)}, ${fmtSlot(order.planned_slot)}`),350);}
            else if(action==='decline'){
              let declineResult;
              try{declineResult=await API.declineOrder(ref);}catch(decErr){
                ldr.remove();
                const em=decErr.message||'';
                const msg=em.toLowerCase().includes('unable to decline')||em.toLowerCase().includes('no date scheduled')||em.toLowerCase().includes('scheduled date on')
                  ?'Unable to decline — no delivery date is scheduled, or the scheduled date is on or before today.'
                  :'Something went wrong while declining. Please try again or contact us.';
                const el=document.createElement('div');el.className='tt-row b';
                el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent"><div class="tt-warn">⚠️ ${msg}</div></div>`;
                state='action';await addEl(el,0);offerNext(400);return;
              }
              await API.addNote(ref,`Declined via Ask Frankie — ${new Date().toLocaleString('en-GB')}`);ldr.remove();state='done';const el=document.createElement('div');el.className='tt-row b';el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent"><div class="tt-err">🚫 <strong>Delivery Declined.</strong> Team notified.</div></div>`;await botMsg("Delivery <strong>declined</strong>.");await addEl(el,250);await addEl(buildSum('decline','Declined — team notified'),250);}
            else if(action==='instructions'){ldr.remove();state='instructions';const isCon=order.confirmed==='True';const instrMsg='Please type your delivery instructions below 📝:<br><br><em style="font-size:11.5px;color:#666">⚠️ Please note if you are asking us to leave goods without a signature this can only be authorised by your retailer.</em>';if(isCon){await botMsg(instrMsg);qrs([{label:'✕ Cancel',fn:()=>{dQR();userMsg('Cancel');cancelFlow();},cls:'grey'}],400);}else{const weekOpts=getNextWeekdayOptions();await botMsg(instrMsg);qrs([...weekOpts.map(o=>({label:o.label,fn:()=>{dQR();userMsg(o.label);doInstr(o.instruction);}})),{label:'✕ Cancel',fn:()=>{dQR();userMsg('Cancel');cancelFlow();},cls:'grey'}],400);}return;}
            offerNext(550);
          }catch(e){ldr.remove();await showErr(e,'action');}
        }

        async function doInstr(val){
          state='processing';const ref=order.carrier_reference;const ldr=ldrMsg('Saving…');
          try{await API.updateInstructions(ref,val);await API.addNote(ref,`Instructions via Ask Frankie: "${val}" — ${new Date().toLocaleString('en-GB')}`);ldr.remove();state='done';await botMsg(`✅ <strong>Saved!</strong> Your instructions have been added to your order.<blockquote style="border-left:3px solid var(--tt-primary);padding-left:10px;margin:7px 0;font-style:italic">"${xe(val)}"</blockquote>`);await addEl(buildSum('instructions',val),350);offerNext(500);}catch(e){ldr.remove();await showErr(e,'action');}
        }

        async function showErr(e,ctx){
          state=ctx==='lookup'?'lookup':'action';
          let msg=(ctx==='lookup'&&(e.code==='NOT_FOUND'||e.code==='API'))
            ?'No matching consignment found. You recently received an email from Furdeco with regards to your order — you will find your consignment number on this email.'
            :e.code==='NOT_FOUND'?e.message:e.code==='TIMEOUT'?'The request took too long. Please try again.':e.code==='HTTP'?'Connection issue. Please try again.':'Something went wrong. Please try again.';
          const el=document.createElement('div');el.className='tt-row b';el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent"><div class="tt-err">❌ ${msg}</div></div>`;
          await addEl(el,0);qrs([{label:'🔄 Try Again',fn:()=>{dQR();userMsg('Try again');resetLookup();}},{label:'👤 Talk to a Human',fn:()=>{dQR();userMsg('Talk to a human');humanHandoff();}}],350);
        }

        async function humanHandoff(){
          state='done';
          // ── Live chat guard: OTP verified + order received at warehouse ───
          if(otpVerified&&order?.order_steps?.received==='Yes'){
            await startLiveChatFlow();return;
          }
          // ── Fallback: show contact details (original behaviour) ───────────
          await botMsg("Here are our contact details 👤");
          const el=document.createElement('div');el.className='tt-row b';
          el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent"><div class="tt-info">📞 <strong>Phone:</strong> <a href="tel:${CONFIG.SUPPORT_PHONE.replace(/\s/g,'')}" style="color:#1c5a28;font-weight:600">${CONFIG.SUPPORT_PHONE}</a><br>📧 <strong>Email:</strong> ${xe(CONFIG.SUPPORT_EMAIL)}<br>🕐 <strong>Hours:</strong> ${xe(CONFIG.SUPPORT_HOURS)}</div></div>`;
          await addEl(el,300);qrs([{label:'🤖 Continue with Ask Frankie',fn:()=>{userMsg('Continue');resetLookup();}},{label:'👋 All Done',fn:()=>{dQR();userMsg('All done');goodbye();}}],450);
        }

        async function cancelFlow(){await botMsg("No problem! ↩️ Nothing changed.");resetLookup();}

        async function offerNext(ms=800){
          setTimeout(async()=>{await botMsg("Anything else I can help with?",0);qrs([{label:'🔍 Track Another',fn:()=>{userMsg('Track another');resetLookup();}},{label:'👤 Talk to a Human',fn:()=>{dQR();userMsg('Talk to a human');humanHandoff();}},{label:'👋 All Done',fn:()=>{dQR();userMsg('All done');goodbye();}}],350);state='post_action';},ms);
        }

        function resetLookup(){order=null;action=null;pRef=null;pPc=null;pRefType='consignment';otpEmail=null;otpType='email';otpIdentifier=null;otpAttempts=0;otpVerified=false;clearInterval(resendTimer);state='lookup_type';setStep('ref');botMsg('How would you like to track your order?');qrs([{label:'📦 Consignment Number',fn:()=>{pRefType='consignment';userMsg('Consignment Number');state='lookup';setStep('ref');botMsg('Please enter your <strong>consignment number</strong>.');}},{label:'🛒 Order Number',fn:()=>{pRefType='order';userMsg('Order Number');state='lookup';setStep('ref');botMsg('Please enter your <strong>order number</strong>.');}}]);}

        async function goodbye(){state='done';await botMsg(`Thanks for using <strong>Ask Frankie</strong>! 👋<br>📞 ${CONFIG.SUPPORT_PHONE} · 📧 ${CONFIG.SUPPORT_EMAIL}`);}

        function buildCard(o,status){
          const STEPS=[{k:'received',l:'Received'},{k:'scheduled',l:'Scheduled'},{k:'routed',l:'En Route'},{k:'confirmed',l:'Confirmed'},{k:'delivered',l:'Delivered'}];
          const stage=STEPS.findLastIndex(s=>o.order_steps[s.k]==='Yes');
          let trk='<div class="tt-trk">';
          STEPS.forEach((s,i)=>{const done=o.order_steps[s.k]==='Yes';const cur=i===stage&&done;trk+=`<div class="tt-ts ${done?(cur?'cur':'done'):''}"><div class="tt-tdot">${done?(cur?'●':'✓'):''}</div><div class="tt-tlbl">${s.l}</div></div>`;});
          trk+='</div>';
          const prods=(o.products||[]).slice(0,2).map(p=>`<div class="tt-dr"><span class="tt-dk">${xe(p.part)}</span><span class="tt-dv">${xe(p.description)}</span></div>`).join('');
          const svcs=[o.services?.service_level,o.services?.delivery_point].filter(v=>v&&v!=='N/A');
          const svcHTML=svcs.length?`<div class="tt-svcs">${svcs.map(s=>`<span class="tt-svc">${xe(s)}</span>`).join('')}</div>`:'';
          const cb=o.confirmed==='True'?`<span style="font-size:10px;color:var(--tt-primary-dark);font-weight:700;margin-left:5px">✓ Confirmed</span>`:'';
          const statusLowerCard=(o.status||'').toLowerCase();
          const isOnHoldCard=statusLowerCard.includes('on hold');
          const isCancelledCard=statusLowerCard.includes('cancel');
          let dateDisplay;
          if(isCancelledCard){dateDisplay=`<span style="font-size:10px;font-weight:700;color:#dc2626;background:#fef2f2;padding:2px 7px;border-radius:100px">🚫 Cancelled</span>`;}
          else if(isOnHoldCard){dateDisplay=`<span style="font-size:10px;font-weight:700;color:#92400e;background:#fff8ec;padding:2px 7px;border-radius:100px">⏸ On Hold</span>`;}
          else{dateDisplay=`🗓 ${fmtDate(o.planned_date)}${cb}`;}
          const el=document.createElement('div');el.className='tt-row b';
          el.innerHTML=`<div class="tt-bbl" style="max-width:97%;padding:0;background:transparent"><div class="tt-card"><div class="tt-ct">📦 Order Details</div><div class="tt-dr"><span class="tt-dk">Consignment</span><span class="tt-dv">${xe(o.carrier_reference)}</span></div><div class="tt-dr"><span class="tt-dk">Order No.</span><span class="tt-dv">${xe(o.order_number)}</span></div><div class="tt-dr"><span class="tt-dk">Retailer</span><span class="tt-dv">${xe(o.sender_company)}</span></div><div class="tt-dr"><span class="tt-dk">Recipient</span><span class="tt-dv">${xe(o.recipient)}</span></div><div class="tt-dr"><span class="tt-dk">Address</span><span class="tt-dv">${xe(o.address)}, ${xe(o.postcode)}</span></div>${prods}<div class="tt-dr" style="margin-top:4px"><span class="tt-dk">Date</span><span class="tt-dv">${dateDisplay}</span></div><div class="tt-dr"><span class="tt-dk">Slot</span><span class="tt-dv">🕐 ${fmtSlot(o.planned_slot)}</span></div><span class="tt-sb ${status.key}">${xe(status.label)}</span>${svcHTML}${trk}</div></div>`;
          return el;
        }

        /* ── Haversine distance ─────────────────────────────── */
        function haversineKm(lat1,lng1,lat2,lng2){
          const R=6371,dLat=(lat2-lat1)*Math.PI/180,dLng=(lng2-lng1)*Math.PI/180;
          const a=Math.sin(dLat/2)**2+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)**2;
          return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
        }
        function fmtDist(km){return km<1?`${Math.round(km*1000)} m away`:`${km.toFixed(1)} km away`;}

        /* ── Inject Leaflet once ─────────────────────────── */
        let _leafletReady=false,_leafletCallbacks=[];
        function ensureLeaflet(cb){
          if(_leafletReady){cb();return;}
          _leafletCallbacks.push(cb);
          if(_leafletCallbacks.length>1)return;
          const css=document.createElement('link');css.rel='stylesheet';
          css.href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
          document.head.appendChild(css);
          const js=document.createElement('script');
          js.src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
          js.onload=()=>{_leafletReady=true;_leafletCallbacks.forEach(f=>f());_leafletCallbacks=[];};
          document.head.appendChild(js);
        }

        /* ── Main map builder ────────────────────────────── */
        let _mapCounter=0;
        function buildMap(o){
          const dLat=parseFloat(o.lat), dLng=parseFloat(o.lng);
          if(!dLat||!dLng||isNaN(dLat)||isNaN(dLng))return null;

          /* Parse driver location — prefer sorss_live_location, fallback live_location */
          const ri=o.route_info||{};
          function parseLoc(s){
            if(!s||s==='N/A'||s.trim()==='')return null;
            const p=s.split(',');
            if(p.length<2)return null;
            const la=parseFloat(p[0].trim()),ln=parseFloat(p[1].trim());
            return(isNaN(la)||isNaN(ln))?null:{lat:la,lng:ln};
          }
          const driverPos=parseLoc(ri.sorss_live_location)||parseLoc(ri.live_location);
          const hasDriver=!!driverPos;
          const distStr=hasDriver?fmtDist(haversineKm(driverPos.lat,driverPos.lng,dLat,dLng)):'';
          const reg=(ri.registration&&ri.registration!=='N/A')?ri.registration:'';
          const dropsInfo=(ri.drops_current&&ri.drops_current!=='N/A'&&ri.drops_total&&ri.drops_total!=='N/A')
            ?`Stop ${ri.drops_current} of ${ri.drops_total}`:'';

          const mapId='tt-map-'+(++_mapCounter);
          const linkUrl=`https://www.openstreetmap.org/?mlat=${dLat}&mlon=${dLng}#map=15/${dLat}/${dLng}`;

          const el=document.createElement('div');el.className='tt-row b';
          el.innerHTML=`<div class="tt-bbl" style="max-width:97%;padding:0;background:transparent">
            <div class="tt-card" style="padding:0;overflow:hidden">
              <div style="padding:10px 13px 8px;display:flex;align-items:center;justify-content:space-between">
                <span style="font-family:'Syne',sans-serif;font-weight:700;font-size:12px;color:#1c1c1e">
                  ${hasDriver?'🚚 Driver Location':'📍 Delivery Address'}
                </span>
                <a href="${linkUrl}" target="_blank" style="font-size:10px;color:var(--tt-primary);font-weight:600;text-decoration:none">Open in Maps ↗</a>
              </div>
              ${hasDriver?`<div style="display:flex;gap:6px;flex-wrap:wrap;padding:0 13px 8px">
                ${distStr?`<span style="background:#e8f7ea;color:#1c5a28;font-size:10px;font-weight:700;padding:2px 9px;border-radius:100px">📏 ${distStr}</span>`:''}
                ${reg?`<span style="background:#f0f0f5;color:#48484a;font-size:10px;font-weight:600;padding:2px 9px;border-radius:100px">🚛 ${xe(reg)}</span>`:''}
                ${dropsInfo?`<span style="background:#fff3cd;color:#856404;font-size:10px;font-weight:600;padding:2px 9px;border-radius:100px">📦 ${xe(dropsInfo)}</span>`:''}
              </div>`:''}
              <div id="${mapId}" style="width:100%;height:190px"></div>
              <div style="padding:7px 13px;font-size:10.5px;color:#8e8e93;border-top:1px solid #f5f5f7">
                ${hasDriver?'':`<span style="color:#e07b00;font-weight:600">ℹ️ No driver location available — delivery not yet assigned to a route.</span><br>`}
                📍 ${xe(o.address)}, ${xe(o.postcode)}
              </div>
            </div>
          </div>`;

          ensureLeaflet(()=>{
            /* Defer until el is in the DOM and has real pixel dimensions */
            setTimeout(()=>{
              const mapDiv=document.getElementById(mapId);
              if(!mapDiv)return;
              const map=L.map(mapDiv,{zoomControl:true,scrollWheelZoom:false,attributionControl:false});
              L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18}).addTo(map);

              /* Delivery pin */
              const houseIcon=L.divIcon({html:`<div style="background:#3AB54A;width:28px;height:28px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,.3)"><div style="transform:rotate(45deg);text-align:center;line-height:22px;font-size:12px">🏠</div></div>`,iconSize:[28,28],iconAnchor:[14,28],className:''});
              const homeMarker=L.marker([dLat,dLng],{icon:houseIcon}).addTo(map);
              homeMarker.bindPopup(`<strong>Delivery Address</strong><br>${xe(o.address)}, ${xe(o.postcode)}`);

              if(hasDriver){
                /* Driver pin */
                const truckIcon=L.divIcon({html:`<div style="background:#1d4ed8;width:30px;height:30px;border-radius:50%;border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,.3);display:flex;align-items:center;justify-content:center;font-size:15px">🚚</div>`,iconSize:[30,30],iconAnchor:[15,15],className:''});
                const driverMarker=L.marker([driverPos.lat,driverPos.lng],{icon:truckIcon}).addTo(map);
                const popTxt=`<strong>Driver</strong>${reg?`<br>Vehicle: ${reg}`:''}${dropsInfo?`<br>${dropsInfo}`:''}${distStr?`<br>${distStr}`:''}`;
                driverMarker.bindPopup(popTxt);

                /* Dashed route line */
                L.polyline([[driverPos.lat,driverPos.lng],[dLat,dLng]],{
                  color:'#1d4ed8',weight:3,dashArray:'8 6',opacity:0.75
                }).addTo(map);

                /* Fit both markers */
                const bounds=L.latLngBounds([[driverPos.lat,driverPos.lng],[dLat,dLng]]);
                map.fitBounds(bounds,{padding:[30,30]});
              } else {
                map.setView([dLat,dLng],15);
                homeMarker.openPopup();
              }

              /* Force tile redraw in case container was scrolled/hidden during init */
              setTimeout(()=>map.invalidateSize(),150);
            },300);
          });

          return el;
        }

        function buildSum(a,detail){
          const lbl={confirm:'✅ Confirmed',decline:'❌ Declined',instructions:'📝 Instructions Added'};
          const el=document.createElement('div');el.className='tt-row b';
          el.innerHTML=`<div class="tt-bbl" style="max-width:97%;padding:0;background:transparent"><div class="tt-sum"><div class="tt-sum-t">Session Summary</div><div class="tt-sr"><span class="tt-sk">Consignment</span><span class="tt-sv">${xe(order?.carrier_reference||'–')}</span></div><div class="tt-sr"><span class="tt-sk">Action</span><span class="tt-sv">${lbl[a]||a}</span></div><div class="tt-sr"><span class="tt-sk">Detail</span><span class="tt-sv">${xe(detail)}</span></div><div class="tt-sr"><span class="tt-sk">Time</span><span class="tt-sv">${new Date().toLocaleString('en-GB')}</span></div></div></div>`;
          return el;
        }

        // ═══════════════════════════════════════════════════════════════════
        // LIVE CHAT LAYER — all functions below are additive.
        // They only execute when the guard condition is met.
        // Zero impact on the existing tracking / OTP / action flow.
        // ═══════════════════════════════════════════════════════════════════

        async function startLiveChatFlow(){
          await botMsg("🙋 <strong>Connect to a Live Agent</strong><br>One of our team will assist you shortly.");
          lc._name='';
          state='lc_name';
          const hint=order?.recipient?` (you can reply <strong>${xe(order.recipient)}</strong>)`:'';
          await botMsg(`First, what <strong>name</strong> should the agent use?${hint}`);
          qrs([{label:'✖ Cancel',fn:()=>{dQR();userMsg('Cancel');window._lcCancelPrechat();}}],300);
        }

        window._lcCancelPrechat=function(){
          state='post_action';
          botMsg("No problem! Is there anything else I can help you with?",0);
          qrs([{label:'🔍 Track Another',fn:()=>{userMsg('Track another');resetLookup();}},{label:'📞 Contact Us',fn:()=>{userMsg('Contact details');showContactDetails();}},{label:'👋 All Done',fn:()=>{dQR();userMsg('All done');goodbye();}}],300);
        };

        // Compact snapshot of the looked-up order, sent to the backend when the
        // chat is queued so the agent/admin can see the order context.
        function _lcOrderSnapshot(){
          if(!order)return '';
          try{
            return JSON.stringify({
              reference:    order.carrier_reference||pRef||'',
              order_number: order.order_number||'',
              retailer:     order.sender_company||'',
              recipient:    order.recipient||'',
              address:      order.address||'',
              postcode:     order.postcode||pPc||'',
              status:       order.status||'',
              confirmed:    order.confirmed||'',
              planned_date: order.planned_date||'',
              planned_slot: order.planned_slot||null,
              products:     Array.isArray(order.products)?order.products.slice(0,6).map(p=>({part:p.part,description:p.description})):[],
              services:     order.services?{service_level:order.services.service_level,delivery_point:order.services.delivery_point}:null,
              order_steps:  order.order_steps||null,
              email:        order.email||'',
              mobile:       order.contact_mobile||''
            });
          }catch(e){return '';}
        }

        async function lcConnect(customerName,issueDescription){
          lc._closed=false;
          const ldr=ldrMsg('Connecting to an agent…');
          try{
            const conn=new signalR.HubConnectionBuilder()
              .withUrl('/hubs/livechat')
              .withAutomaticReconnect()
              .build();
            lc.connection=conn;

            conn.on('AgentJoined',agentName=>{
              lc.status='active';lc.agentName=agentName;
              showActiveChatUI(agentName);
            });
            conn.on('MessageReceived',msg=>{
              if(msg.senderType==='Agent'||msg.senderType==='Admin'){
                lcAddMsg(msg.content,msg.senderName,'b',msg.timestamp);
              }
            });
            conn.on('AgentTyping',()=>_lcShowTyping());
            conn.on('AgentStoppedTyping',()=>_lcClearTyping());
            conn.on('ChatEnded',()=>{lc.status='ended';lcEndedByAgent();});

            conn.onreconnected(async()=>{
              if(lc.sessionId)try{await conn.invoke('RejoinSession',lc.sessionId);}catch(e){}
            });

            await conn.start();
            const result=await conn.invoke('JoinQueue',pRef||'',pPc||'',customerName,issueDescription,_lcOrderSnapshot());
            lc.sessionId=result.sessionId;
            lc.status='queued';
            localStorage.setItem(LC_KEY,String(lc.sessionId));

            ldr.remove();
            showQueueScreen(result.position||1);
          }catch(e){
            ldr.remove();
            await botMsg("❌ Couldn't connect to live chat right now. Please try again or use our contact details.");
            qrs([{label:'🔄 Try Again',fn:()=>{userMsg('Try again');startLiveChatFlow();}},{label:'📞 Contact Us',fn:()=>{userMsg('Contact details');showContactDetails();}}],400);
          }
        }

        function showQueueScreen(position){
          document.querySelectorAll('#lc-queue-screen').forEach(n=>{const r=n.closest('.tt-row');(r||n).remove();});
          const el=document.createElement('div');el.className='tt-row b';
          el.innerHTML=`<div class="tt-bbl" style="max-width:97%;padding:0;background:transparent">
            <div class="tt-info" id="lc-queue-screen">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                <div class="tt-spn"></div><strong>Waiting for an agent…</strong>
              </div>
              <div id="lc-queue-pos" style="font-size:11.5px;color:#1c5a28">You are #${position} in the queue</div>
              <div style="font-size:10.5px;color:#3a7a46;margin-top:4px">Please stay on this page. An agent will connect shortly.</div>
              <button class="tt-qr grey" style="margin-top:10px;font-size:11px" onclick="window._lcLeaveQueue()">Leave Queue</button>
            </div>
          </div>`;
          msgs.appendChild(el);sd();
        }

        window._lcLeaveQueue=async function(){
          if(lc.connection&&lc.sessionId)try{await lc.connection.invoke('LeaveQueue',lc.sessionId);}catch(e){}
          lc.status=null;lc.sessionId=null;localStorage.removeItem(LC_KEY);
          document.querySelectorAll('#lc-queue-screen').forEach(n=>{const r=n.closest('.tt-row');(r||n).remove();});
          userMsg('Leave queue');state='action';
          await botMsg("You've left the queue. Is there anything else I can help you with?",0);
          qrs([{label:'🤖 Continue with Ask Frankie',fn:()=>{userMsg('Continue');resetLookup();}},{label:'📞 Contact Us',fn:()=>{userMsg('Contact details');showContactDetails();}},{label:'👋 All Done',fn:()=>{dQR();userMsg('All done');goodbye();}}],400);
        };

        function showActiveChatUI(agentName){
          document.querySelectorAll('#lc-queue-screen').forEach(n=>{const r=n.closest('.tt-row');(r||n).remove();});
          raw(`<div class="tt-row b"><div class="tt-bbl">✅ <strong>${xe(agentName)}</strong> has joined the chat!</div></div>`);sd();
          // Switch the single (outer) composer into live-chat mode rather than
          // rendering a separate nested chat box. Messages flow into the main
          // conversation stream just like the bot's.
          _lcEnterLiveMode(agentName);
        }

        // Turns the main composer into the live-agent composer: shows the emoji
        // button + the End Chat bar, and routes input to the agent.
        function _lcEnterLiveMode(agentName){
          const em=document.getElementById('tt-emoji');if(em)em.style.display='flex';
          const bar=document.getElementById('lc-bar');if(bar)bar.style.display='flex';
          const bt=document.getElementById('lc-bar-text');if(bt)bt.textContent='Connected to '+(agentName||'agent');
          if(inp){inp.placeholder='Message '+(agentName||'agent')+'…';inp.disabled=false;inp.focus();}
        }

        function _lcExitLiveMode(){
          const em=document.getElementById('tt-emoji');if(em)em.style.display='none';
          const bar=document.getElementById('lc-bar');if(bar)bar.style.display='none';
          const panel=document.getElementById('lc-emoji-panel');if(panel)panel.style.display='none';
          _lcClearTyping();
          if(inp){inp.placeholder='Type a message…';}
        }

        function _lcClearTyping(){
          const t=document.getElementById('lc-typing-row');if(t)t.remove();
        }

        function _lcShowTyping(){
          if(lc.status!=='active')return;
          if(document.getElementById('lc-typing-row'))return;
          const row=document.createElement('div');row.className='tt-row b';row.id='lc-typing-row';
          row.innerHTML=`<div class="tt-typ"><div class="tt-td"></div><div class="tt-td"></div><div class="tt-td"></div></div>`;
          msgs.appendChild(row);sd();
        }

        window._lcToggleEmoji=function(){
          const p=document.getElementById('lc-emoji-panel');
          if(p)p.style.display=(p.style.display==='none'||!p.style.display)?'flex':'none';
        };

        window._lcAddEmoji=function(e){
          if(!inp)return;
          inp.value+=e;inp.focus();
          if(window._lcTyping)window._lcTyping();
        };

        window._lcTyping=function(){
          if(!lc.connection||lc.status!=='active'||!lc.sessionId)return;
          if(!lc._typingOn){lc._typingOn=true;lc.connection.invoke('CustomerTyping',lc.sessionId).catch(()=>{});}
          clearTimeout(lc._typingTimer);
          lc._typingTimer=setTimeout(window._lcStopTyping,2500);
        };

        window._lcStopTyping=function(){
          clearTimeout(lc._typingTimer);
          if(lc._typingOn&&lc.connection&&lc.sessionId){lc._typingOn=false;lc.connection.invoke('CustomerStoppedTyping',lc.sessionId).catch(()=>{});}
        };

        function lcAddMsg(content,senderName,side,ts){
          // Live-chat messages render in the main conversation stream (#tt-msgs),
          // using the .lc-msg bubble styles so they sit alongside the bot's.
          _lcClearTyping();
          const isSup=side!=='u'&&senderName==='Supervisor';
          let tm='';try{tm=new Date(ts||Date.now()).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});}catch(e){}
          const wrap=document.createElement('div');
          wrap.className='lc-msg '+(side==='u'?'u':(isSup?'b sup':'b'));
          const nm=side==='u'?'':`<div class="lc-nm">${isSup?'Supervisor':xe(senderName||'Agent')}</div>`;
          wrap.innerHTML=`${nm}<div class="lc-bbl">${xe(content)}</div><div class="lc-tm">${tm}</div>`;
          msgs.appendChild(wrap);sd();
        }

        window._lcSend=async function(){
          const val=(inp?.value||'').trim();
          if(!val||!lc.connection||lc.status!=='active')return;
          inp.value='';lcAddMsg(val,'You','u');
          window._lcStopTyping();
          try{await lc.connection.invoke('SendMessage',lc.sessionId,val);}catch(e){console.error('[LC] send failed',e);}
        };

        window._lcEnd=async function(){
          if(!lc.sessionId||lc._closed)return;
          if(lc.connection&&lc.status==='active'){
            try{await lc.connection.invoke('EndChat',lc.sessionId);}catch(e){}
          }
          lc.status='ended';lcEndedByCustomer();
        };

        function lcEndedByCustomer(){
          // Guard: the server echoes ChatEnded back to the customer, so without
          // this both lcEndedByCustomer (direct) and lcEndedByAgent (echo) would
          // fire and show the rating card twice.
          if(lc._closed)return;lc._closed=true;
          lcTeardown();
          raw(`<div class="tt-row b"><div class="tt-bbl">Your chat has ended.</div></div>`);sd();
          lcShowRating();
        }

        function lcEndedByAgent(){
          if(lc._closed)return;lc._closed=true;
          lcTeardown();
          raw(`<div class="tt-row b"><div class="tt-bbl">The agent has ended this chat session.</div></div>`);sd();
          lcShowRating();
        }

        function lcTeardown(){
          // Return the composer to normal bot mode; the bot flow continues after
          // the rating prompt, so the input stays enabled.
          _lcExitLiveMode();
          localStorage.removeItem(LC_KEY);
        }

        const LC_RATE_FB=[{e:'😞',t:'Poor'},{e:'😕',t:'Fair'},{e:'🙂',t:'Good'},{e:'😀',t:'Great'},{e:'🤩',t:'Excellent'}];

        function lcShowRating(){
          lc._rating=0;
          setTimeout(async()=>{
            await botMsg("How was your experience with our agent?",0);
            const el=document.createElement('div');el.className='tt-row b';
            el.innerHTML=`<div class="tt-bbl" style="max-width:97%;padding:0;background:transparent">
              <div class="tt-vcard">
                <div class="lc-rate-ttl">Rate your chat</div>
                <div class="lc-rate-sub">Tap a star to let us know how we did</div>
                <div class="lc-stars" id="lc-stars">
                  ${[1,2,3,4,5].map(n=>`<button class="lc-star" id="lc-star-${n}" aria-label="${n} star" onmouseover="window._lcRateHover(${n})" onmouseout="window._lcRateReset()" onclick="window._lcRate(${n})">★</button>`).join('')}
                </div>
                <div class="lc-rate-fb" id="lc-rate-fb"></div>
                <button class="tt-qr grey lc-rate-skip" id="lc-rate-skip" onclick="window._lcSkipRating()">Skip</button>
              </div>
            </div>`;
            msgs.appendChild(el);sd();
          },500);
        }

        window._lcRatePaint=function(n){
          for(let i=1;i<=5;i++){const s=document.getElementById('lc-star-'+i);if(s)s.classList.toggle('on',i<=n);}
          const fb=document.getElementById('lc-rate-fb');if(!fb)return;
          if(n>0){const f=LC_RATE_FB[n-1];fb.innerHTML=`<span style="font-size:20px">${f.e}</span><span class="lc-rate-word">${f.t}</span>`;fb.classList.add('show');}
          else{fb.classList.remove('show');}
        };
        window._lcRateHover=function(n){window._lcRatePaint(n);};
        window._lcRateReset=function(){window._lcRatePaint(lc._rating||0);};

        window._lcRate=async function(n){
          lc._rating=n;window._lcRatePaint(n);
          for(let i=1;i<=5;i++){const s=document.getElementById('lc-star-'+i);if(s)s.disabled=true;}
          const sk=document.getElementById('lc-rate-skip');if(sk)sk.style.display='none';
          const f=LC_RATE_FB[n-1];
          const fb=document.getElementById('lc-rate-fb');
          if(fb){fb.innerHTML=`<span class="lc-rate-em" style="font-size:24px">${f.e}</span><span class="lc-rate-word">${f.t}</span>`;fb.classList.add('show');}
          try{await tf(`/api/livechat/sessions/${lc.sessionId}/rate`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({rating:n})});}catch(e){}
          await botMsg(`Thanks for your ${n}★ rating! Is there anything else I can help with?`,0);
          lcPostChatOptions();
        };

        window._lcSkipRating=function(){
          botMsg("No problem! Is there anything else I can help with?",0);
          lcPostChatOptions();
        };

        function lcPostChatOptions(){
          // Properly close the old SignalR connection before clearing the reference.
          if(lc.connection)lc.connection.stop().catch(()=>{});
          lc.sessionId=null;lc.connection=null;lc.status=null;lc.agentName=null;
          qrs([{label:'🤖 Continue with Ask Frankie',fn:()=>{userMsg('Continue');resetLookup();}},{label:'📞 Contact Us',fn:()=>{userMsg('Contact details');showContactDetails();}},{label:'👋 All Done',fn:()=>{dQR();userMsg('All done');goodbye();}}],400);
        }

        function showContactDetails(){
          state='done';
          const el=document.createElement('div');el.className='tt-row b';
          el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent"><div class="tt-info">📞 <strong>Phone:</strong> <a href="tel:${CONFIG.SUPPORT_PHONE.replace(/\s/g,'')}" style="color:#1c5a28;font-weight:600">${CONFIG.SUPPORT_PHONE}</a><br>📧 <strong>Email:</strong> ${xe(CONFIG.SUPPORT_EMAIL)}<br>🕐 <strong>Hours:</strong> ${xe(CONFIG.SUPPORT_HOURS)}</div></div>`;
          addEl(el,300);
        }

        // ── Session restore function (called from the startup flow) ──────────
        async function lcRestore(savedId,data){
          lc._closed=false;
          lc.sessionId=savedId;
          lc.status=data.status==='Active'?'active':'queued';
          lc.agentName=data.agentName||null;
          await botMsg("🔄 <strong>Resuming your previous live chat session…</strong>",0);

          const conn=new signalR.HubConnectionBuilder()
            .withUrl('/hubs/livechat').withAutomaticReconnect().build();
          lc.connection=conn;

          conn.on('AgentJoined',agentName=>{
            lc.status='active';lc.agentName=agentName;showActiveChatUI(agentName);
          });
          conn.on('MessageReceived',msg=>{
            if(msg.senderType==='Agent'||msg.senderType==='Admin')lcAddMsg(msg.content,msg.senderName,'b',msg.timestamp);
          });
          conn.on('AgentTyping',()=>_lcShowTyping());
          conn.on('AgentStoppedTyping',()=>_lcClearTyping());
          conn.on('ChatEnded',()=>{lc.status='ended';lcEndedByAgent();});

          conn.onreconnected(async()=>{
            if(lc.sessionId)try{await conn.invoke('RejoinSession',lc.sessionId);}catch(e){}
          });

          await conn.start();
          await conn.invoke('RejoinSession',savedId);

          // Replay message history
          if(data.messages?.length){
            if(lc.status==='active')showActiveChatUI(lc.agentName||'Agent');
            data.messages.forEach(m=>{lcAddMsg(m.content,m.senderName,m.senderType==='Customer'?'u':'b',m.timestamp);});
          } else if(lc.status==='active'){
            showActiveChatUI(lc.agentName||'Agent');
          } else {
            showQueueScreen(data.queuePosition||1);
          }
        }
        // ═══════════════════════════════════════════════════════════════════

        (function attachSend(){
          const btn=document.getElementById('tt-snd');
          const inputEl=document.getElementById('tt-inp');
          if(btn)btn.addEventListener('click',function(){handleInput();});
          if(inputEl){
            inputEl.addEventListener('keydown',function(e){if(e.key==='Enter')handleInput();});
            // Emit typing to the agent only while a live chat is active.
            inputEl.addEventListener('input',function(){if(lc.status==='active'&&window._lcTyping)window._lcTyping();});
          }
          // Populate the (shared) emoji panel once.
          const panel=document.getElementById('lc-emoji-panel');
          if(panel)panel.innerHTML=LC_EMOJIS.map(e=>`<button type="button" onclick="window._lcAddEmoji('${e}')" style="background:none;border:none;cursor:pointer;font-size:18px;line-height:1;padding:3px 5px;border-radius:6px">${e}</button>`).join('');
        })();
    </script>
</body>
</html>
