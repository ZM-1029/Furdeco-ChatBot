        async function mdPost(ref, action, extraFields = {}) {

          const endpointMap = {
            confirm: '/api/chat/confirm',
            decline: '/api/chat/decline',
            update_field: '/api/chat/instructions',
            add_note: '/api/chat/note'
          };

          const formData = new URLSearchParams();
          formData.append("reference", ref);

          if (action === "update_field")
              formData.append("instructions", extraFields.OtherInstructions);

          if (action === "add_note")
              formData.append("note", extraFields.Note);

          const r = await tf(endpointMap[action], {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: formData
          });

          return pAct(await r.text());
        }

async function tf(url, opts={}, ms=12000) {
  const c = new AbortController();
  const id = setTimeout(() => c.abort(), ms);
  try {
    const r = await fetch(url, { ...opts, signal: c.signal });
    clearTimeout(id);
    if (!r.ok) throw new Err('HTTP', `Error ${r.status}`);
    return r;
  } catch(e) {
    clearTimeout(id);
    if (e.name === 'AbortError') throw new Err('TIMEOUT', 'Request timed out.');
    throw e;
  }
}

function pTrk(xml) {
  const d = new DOMParser().parseFromString(xml, 'text/xml');
  const g = t => d.querySelector(t)?.textContent?.trim() || 'N/A';
  const gi = (p,t) => d.querySelector(`${p} > ${t}`)?.textContent?.trim() || 'N/A';
  if (d.querySelector('error')) throw new Err('API', g('error'));
  return {
    carrier_reference: g('carrier_reference'), order_number: g('order_number'),
    recipient: g('recipient'), sender_company: g('sender_company'),
    address: g('address'), postcode: g('postcode'),
    contact_mobile: g('contact_mobile'), contact_home: g('contact_home'), email: g('email'),
    planned_date: g('planned_date'),
    planned_slot: { start: gi('planned_slot','start'), end: gi('planned_slot','end') },
    confirmed: g('confirmed'), delivery_instructions: g('delivery_instructions'),
    order_steps: {
      released: gi('order_steps','released'), received: gi('order_steps','received'),
      scheduled: gi('order_steps','scheduled'), routed: gi('order_steps','routed'),
      confirmed: gi('order_steps','confirmed'), delivered: gi('order_steps','delivered'),
    },
    order_options: {
      allow_cancel_request: gi('order_options','allow_cancel_request'),
      allow_service_request: gi('order_options','allow_service_request'),
    },
    products: [...d.querySelectorAll('products > delivery > product')].map(p => ({
      description: p.querySelector('description')?.textContent?.trim() || '',
      part: p.querySelector('part')?.textContent?.trim() || '',
    })),
    services: {
      service_level: gi('services','service_level'),
      delivery_point: gi('services','delivery_point'),
    },
  };
}

function pAct(xml) {
  const d = new DOMParser().parseFromString(xml, 'text/xml');
  const e = d.querySelector('error')?.textContent?.trim();
  if (e) throw new Err('API', e);
  return { success: d.querySelector('success')?.textContent?.trim() };
}

/* HELPERS */
function verifyIdentity(v,o){const n=s=>(s||'').toLowerCase().replace(/[\s\-().+]/g,'');const i=n(v);if(!i)return false;const m=n(o.contact_mobile),h=n(o.contact_home),e=n(o.email);return(m&&m!=='n/a'&&i===m)||(h&&h!=='n/a'&&i===h)||(e&&e!=='n/a'&&i===e);}
function deriveStatus(s){if(s.delivered==='Yes')return{label:'Delivered',key:'bd'};if(s.routed==='Yes')return{label:'Out for Delivery',key:'bo'};if(s.scheduled==='Yes')return{label:'Scheduled',key:'bs'};if(s.received==='Yes')return{label:'In Warehouse',key:'bw'};return{label:'Order Created',key:'bw'};}
function fmtDate(s){if(!s||s==='N/A')return'TBC';try{return new Date(s.replace(/\//g,'-')).toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short',year:'numeric'});}catch{return s;}}
function fmtSlot(sl){if(!sl||sl.start==='TBC'||sl.start==='N/A')return'To be confirmed';return`${sl.start} – ${sl.end}`;}
function dl(ms){return new Promise(r=>setTimeout(r,ms));}
function xe(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

