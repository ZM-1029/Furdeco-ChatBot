/* ================================================================
   API LAYER
   In test mode, calls Multidrop directly using CUSTOMER_URL + API_KEY
   NOTE: This will only work if your IP is whitelisted by Multidrop,
   OR if you are testing from a whitelisted office/VPN connection.
   ================================================================ */
class Err extends Error{constructor(c,m){super(m);this.code=c;}}

const API = {

  // GET order tracking data
  // Multidrop endpoint: GET https://furdeco.gsit.co.uk/_portal/api/_tracking/?key={API_KEY}&carrier_reference={consignment}
  async getOrder(ref, pc) {
    if (CONFIG.DEMO_MODE) {
      await dl(1100);
      const k = `${ref.toUpperCase()}|${pc.toUpperCase().trim()}`;
      const o = DEMO_DB[k];
      if (!o) throw new Err('NOT_FOUND', `No order found for <strong>${xe(ref)}</strong> at <strong>${xe(pc)}</strong>.`);
      return JSON.parse(JSON.stringify(o));
    }
    // LIVE — calls Multidrop directly with just carrier_reference (postcode not needed in URL)
   // const url = `${CONFIG.CUSTOMER_URL}/_portal/api/_tracking/?key=${CONFIG.API_KEY}&carrier_reference=${encodeURIComponent(ref)}&postcode=${encodeURIComponent(pc)}`;
    //const r = await tf(url);
    const url = `/api/chat/track?reference=${encodeURIComponent(ref)}&postcode=${encodeURIComponent(pc)}`;
 const r = await tf(url);
    return pTrk(await r.text());
  },

  // POST confirm delivery
  // Multidrop endpoint: POST https://furdeco.gsit.co.uk/_portal/api/_orders/update/?key={API_KEY}&carrier_reference=&action=confirm
  async confirmOrder(ref) {
    if (CONFIG.DEMO_MODE) { await dl(900); return { success: 'ok' }; }
    return mdPost(ref, 'confirm');
  },

  // POST decline delivery
  // Multidrop endpoint: POST https://furdeco.gsit.co.uk/_portal/api/_orders/update/?key={API_KEY}&carrier_reference=&action=decline
  async declineOrder(ref) {
    if (CONFIG.DEMO_MODE) { await dl(900); return { success: 'ok' }; }
    return mdPost(ref, 'decline');
  },

  // POST update delivery instructions
  // Multidrop endpoint: POST https://furdeco.gsit.co.uk/_portal/api/_orders/update/?key={API_KEY}&carrier_reference=&action=update_field
  async updateInstructions(ref, txt) {
    if (CONFIG.DEMO_MODE) { await dl(800); return { success: 'ok' }; }
    return mdPost(ref, 'update_field', { OtherInstructions: txt });
  },

  // POST add audit note
  // Multidrop endpoint: POST https://furdeco.gsit.co.uk/_portal/api/_orders/update/?key={API_KEY}&carrier_reference=&action=add_note
  async addNote(ref, note) {
    if (CONFIG.DEMO_MODE) { await dl(400); return { success: 'ok' }; }
    return mdPost(ref, 'add_note', { Note: note });
  },
};

