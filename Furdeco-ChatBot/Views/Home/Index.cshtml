@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrackIT by Furdeco</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap" rel="stylesheet">
</head>
<body>
    <script>
        /* ================================================================
           TrackIT — PRODUCTION VERSION with OTP Verification
           Flow: Consignment → Postcode → Email OTP → Order Details → Actions
           ================================================================ */

        const CONFIG = {
          DEMO_MODE: false,
          API_TIMEOUT_MS: 15000,
          SUPPORT_PHONE: '+44 (0) 121 285 5255',
          SUPPORT_EMAIL: 'info@furdeco.co.uk',
          SUPPORT_HOURS: 'Mon–Sat, 8am–8pm',
          /* Furdeco brand colours — align with furdeco_brand_guidelines_v1-2_2023_draft.pdf */
          BRAND_PRIMARY: '#3AB54A',
          BRAND_PRIMARY_DARK: '#2a8f38',
          BRAND_PRIMARY_LIGHT: '#4fd45f',
          BRAND_HEADER_START: '#1e7a2b',
          BRAND_GRADIENT_MID: '#2fa843',
          BRAND_PRIMARY_RGB: '58, 181, 74',
        };

        /* ================================================================
           DEMO DATA
           ================================================================ */
        const DEMO_DB = {
          'MD-DEMO-001|DL1 1GL': {
            carrier_reference:'MD-DEMO-001', order_number:'ORD-10001',
            recipient:'John Smith', sender_company:'SofaWorld UK',
            address:'14 Oak Avenue, Darlington', postcode:'DL1 1GL',
            contact_mobile:'07700900000', contact_home:'N/A', email:'john@example.com',
            planned_date:'2025/02/20', planned_slot:{start:'09:00',end:'13:00'},
            confirmed:'False', delivery_instructions:'N/A',
            order_steps:{released:'Yes',received:'Yes',scheduled:'Yes',routed:'No',confirmed:'No',delivered:'No'},
            order_options:{allow_cancel_request:'True',allow_service_request:'True'},
            products:[{description:'3-Seater Corner Sofa',part:'1 of 2'},{description:'3-Seater Corner Sofa',part:'2 of 2'}],
            services:{service_level:'2 Man',delivery_point:'Room Of Choice'},
          },
          'MD-DEMO-002|SR6 8LE': {
            carrier_reference:'MD-DEMO-002', order_number:'ORD-10002',
            recipient:'Sarah Jones', sender_company:'Oak & Stone Furniture',
            address:'7 Maple Road, Sunderland', postcode:'SR6 8LE',
            contact_mobile:'07700900001', contact_home:'N/A', email:'sarah@example.com',
            planned_date:'2025/02/22', planned_slot:{start:'14:00',end:'18:00'},
            confirmed:'False', delivery_instructions:'N/A',
            order_steps:{released:'Yes',received:'Yes',scheduled:'No',routed:'No',confirmed:'No',delivered:'No'},
            order_options:{allow_cancel_request:'True',allow_service_request:'True'},
            products:[{description:'Solid Oak Dining Table Set',part:'1 of 3'}],
            services:{service_level:'2 Man',delivery_point:'Room Of Choice'},
          },
          'MD-DEMO-003|PH2 8DD': {
            carrier_reference:'MD-DEMO-003', order_number:'ORD-10003',
            recipient:'Mike Taylor', sender_company:'Dreams Ltd',
            address:'3 River Lane, Perth', postcode:'PH2 8DD',
            contact_mobile:'07700900002', contact_home:'N/A', email:'mike@example.com',
            planned_date:'2025/02/19', planned_slot:{start:'10:00',end:'14:00'},
            confirmed:'True', delivery_instructions:'N/A',
            order_steps:{released:'Yes',received:'Yes',scheduled:'Yes',routed:'Yes',confirmed:'Yes',delivered:'No'},
            order_options:{allow_cancel_request:'False',allow_service_request:'True'},
            products:[{description:'King Size Bed Frame',part:'1 of 2'},{description:'King Size Bed Frame',part:'2 of 2'}],
            services:{service_level:'2 Man',delivery_point:'Room Of Choice'},
          },
        };

        /* ================================================================
           API LAYER
           ================================================================ */
        class Err extends Error{constructor(c,m){super(m);this.code=c;}}

        const API = {
          async getOrder(ref, pc) {
            if (CONFIG.DEMO_MODE) {
              await dl(1100);
              const k = `${ref.toUpperCase()}|${pc.toUpperCase().trim()}`;
              const o = DEMO_DB[k];
              if (!o) throw new Err('NOT_FOUND', `No order found for <strong>${xe(ref)}</strong> at <strong>${xe(pc)}</strong>.`);
              return JSON.parse(JSON.stringify(o));
            }
            const url = `/api/chat/track?reference=${encodeURIComponent(ref)}&postcode=${encodeURIComponent(pc)}&refType=${encodeURIComponent(refType||'consignment')}`;
            const r = await tf(url);
            return pTrk(await r.text());
          },

          async confirmOrder(ref) {
            if (CONFIG.DEMO_MODE) { await dl(900); return { success: 'ok' }; }
            return mdPost(ref, 'confirm');
          },

          async declineOrder(ref) {
            if (CONFIG.DEMO_MODE) { await dl(900); return { success: 'ok' }; }
            return mdPost(ref, 'decline');
          },

          async updateInstructions(ref, txt) {
            if (CONFIG.DEMO_MODE) { await dl(800); return { success: 'ok' }; }
            return mdPost(ref, 'update_field', { OtherInstructions: txt });
          },

          async addNote(ref, note) {
            if (CONFIG.DEMO_MODE) { await dl(400); return { success: 'ok' }; }
            return mdPost(ref, 'add_note', { Note: note });
          },

          async sendOtp(type, identifier) {
            if (CONFIG.DEMO_MODE) {
              await dl(600);
              console.log(`[DEMO] OTP for ${identifier}: 123456`);
              return { message: 'OTP sent successfully' };
            }
            const body = { type };
            if (type === 'email') body.email = identifier; else body.phone = identifier;
            const r = await tf('/api/chat/send-otp', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body)
            });
            return r.json();
          },

          async verifyOtp(type, identifier, otp) {
            if (CONFIG.DEMO_MODE) {
              await dl(500);
              if (otp === '123456') return { message: 'OTP verified' };
              throw new Err('OTP_INVALID', 'Invalid or expired OTP.');
            }
            const body = { otp };
            if (type === 'email') body.email = identifier; else body.phone = identifier;
            const r = await fetch('/api/chat/verify-otp', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body)
            });
            if (!r.ok) {
              const resBody = await r.json().catch(() => ({}));
              throw new Err('OTP_INVALID', resBody.error || 'Invalid or expired OTP.');
            }
            return r.json();
          }
        };

        async function mdPost(ref, action, extraFields = {}) {
          const endpointMap = {
            confirm: '/api/chat/confirm',
            decline: '/api/chat/decline',
            update_field: '/api/chat/instructions',
            add_note: '/api/chat/note'
          };
          const formData = new URLSearchParams();
          formData.append("reference", ref);
          if (action === "update_field") formData.append("instructions", extraFields.OtherInstructions);
          if (action === "add_note") formData.append("note", extraFields.Note);
          const r = await tf(endpointMap[action], {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: formData
          });
          return pAct(await r.text());
        }

        async function tf(url, opts={}, ms) {
          const timeout = (typeof CONFIG !== 'undefined' && CONFIG.API_TIMEOUT_MS) ? CONFIG.API_TIMEOUT_MS : 12000;
          const t = ms ?? timeout;
          const c = new AbortController();
          const id = setTimeout(() => c.abort(), t);
          try {
            const r = await fetch(url, { ...opts, signal: c.signal });
            clearTimeout(id);
            if (r.status === 504) throw new Err('TIMEOUT', 'Request timed out.');
            if (!r.ok) throw new Err('HTTP', `Error ${r.status}`);
            return r;
          } catch(e) {
            clearTimeout(id);
            if (e.name === 'AbortError') throw new Err('TIMEOUT', 'Request timed out.');
            throw e;
          }
        }

        function pTrk(xml) {
          const d = new DOMParser().parseFromString(xml, 'text/xml');
          const g = t => d.querySelector(t)?.textContent?.trim() || 'N/A';
          const gi = (p,t) => d.querySelector(`${p} > ${t}`)?.textContent?.trim() || 'N/A';
          if (d.querySelector('error')) throw new Err('API', g('error'));
          return {
            carrier_reference: g('carrier_reference'), order_number: g('order_number'),
            recipient: g('recipient'), sender_company: g('sender_company'),
            address: g('address'), postcode: g('postcode'),
            contact_mobile: g('contact_mobile'), contact_home: g('contact_home'), email: g('email'),
            planned_date: g('planned_date'),
            planned_slot: { start: gi('planned_slot','start'), end: gi('planned_slot','end') },
            confirmed: g('confirmed'), delivery_instructions: g('delivery_instructions'),
            order_steps: {
              released: gi('order_steps','released'), received: gi('order_steps','received'),
              scheduled: gi('order_steps','scheduled'), routed: gi('order_steps','routed'),
              confirmed: gi('order_steps','confirmed'), delivered: gi('order_steps','delivered'),
            },
            order_options: {
              allow_cancel_request: gi('order_options','allow_cancel_request'),
              allow_service_request: gi('order_options','allow_service_request'),
            },
            products: [...d.querySelectorAll('products > delivery > product')].map(p => ({
              description: p.querySelector('description')?.textContent?.trim() || '',
              part: p.querySelector('part')?.textContent?.trim() || '',
            })),
            services: {
              service_level: gi('services','service_level'),
              delivery_point: gi('services','delivery_point'),
            },
          };
        }

        function pAct(xml) {
          const d = new DOMParser().parseFromString(xml, 'text/xml');
          const e = d.querySelector('error')?.textContent?.trim();
          if (e) throw new Err('API', e);
          return { success: d.querySelector('success')?.textContent?.trim() };
        }

        /* HELPERS */
        function verifyIdentity(v,o){const n=s=>(s||'').toLowerCase().replace(/[\s\-().+]/g,'');const i=n(v);if(!i)return false;const m=n(o.contact_mobile),h=n(o.contact_home),e=n(o.email);return(m&&m!=='n/a'&&i===m)||(h&&h!=='n/a'&&i===h)||(e&&e!=='n/a'&&i===e);}
        function deriveStatus(s){if(s.delivered==='Yes')return{label:'Delivered',key:'bd'};if(s.routed==='Yes')return{label:'Out for Delivery',key:'bo'};if(s.scheduled==='Yes')return{label:'Scheduled',key:'bs'};if(s.received==='Yes')return{label:'In Warehouse',key:'bw'};return{label:'Order Created',key:'bw'};}
        function fmtDate(s){if(!s||s==='N/A')return'TBC';try{return new Date(s.replace(/\//g,'-')).toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short',year:'numeric'});}catch{return s;}}
        function fmtSlot(sl){if(!sl||sl.start==='TBC'||sl.start==='N/A')return'To be confirmed';return`${sl.start} – ${sl.end}`;}
        function dl(ms){return new Promise(r=>setTimeout(r,ms));}
        function xe(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
        /* Next Mon–Fri with day and date for preferred delivery options */
        function getNextWeekdayOptions(){
          const today=new Date();
          const opts=[];
          for(let w=1;w<=5;w++){
            const d=new Date(today);
            const cur=today.getDay();
            const daysAhead=cur===0?w:(w>=cur?w-cur:7-cur+w);
            d.setDate(today.getDate()+daysAhead);
            const dayName=d.toLocaleDateString('en-GB',{weekday:'long'});
            const dateStr=d.toLocaleDateString('en-GB',{day:'numeric',month:'long'});
            opts.push({label:`📅 ${d.toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'})}`,instruction:`Preferred delivery: ${dayName} ${dateStr} (not guaranteed — we will be in touch).`});
          }
          return opts;
        }
        function maskEmail(e){if(!e||!e.includes('@@'))return e;const[u,d]=e.split('@@');return u.slice(0,2)+'•'.repeat(Math.max(2,u.length-2))+'@@'+d;}
        function maskPhone(p){if(!p)return p;const d=(p||'').replace(/\D/g,'');if(d.length<4)return '••••';if(d.startsWith('44')&&d.length>=10)return d.slice(0,5)+'•••'+d.slice(-4);return d.slice(0,3)+'•••'+d.slice(-4);}

        /* STYLES */
        const s=document.createElement('style');
        s.textContent=`
        :root{--tt-primary:${CONFIG.BRAND_PRIMARY};--tt-primary-dark:${CONFIG.BRAND_PRIMARY_DARK};--tt-primary-light:${CONFIG.BRAND_PRIMARY_LIGHT};--tt-header-start:${CONFIG.BRAND_HEADER_START};--tt-gradient-mid:${CONFIG.BRAND_GRADIENT_MID};--tt-primary-rgb:${CONFIG.BRAND_PRIMARY_RGB};}
        @@import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap');
        *{box-sizing:border-box}
        #tt-bubble{position:fixed;bottom:28px;right:28px;z-index:999999;font-family:'DM Sans',sans-serif}

        /* TOGGLE BUTTON */
        #tt-toggle{width:68px;height:68px;background:var(--tt-primary);border-radius:50%;border:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;box-shadow:0 8px 28px rgba(var(--tt-primary-rgb),.45);transition:all .25s;position:relative;animation:ttPop .6s ease both 1.5s}
        @@keyframes ttPop{from{transform:scale(0);opacity:0}60%{transform:scale(1.12)}to{transform:scale(1);opacity:1}}
        #tt-toggle:hover{transform:scale(1.08);box-shadow:0 12px 36px rgba(var(--tt-primary-rgb),.55)}
        #tt-toggle svg{color:white;flex-shrink:0}
        .tt-lbl{font-family:'Syne',sans-serif;font-size:9px;font-weight:700;color:white;letter-spacing:.5px}
        .tt-dot{position:absolute;top:6px;right:6px;width:14px;height:14px;background:#ff3b30;border-radius:50%;border:2px solid white;font-size:8px;color:white;display:flex;align-items:center;justify-content:center;font-weight:700;animation:ttPulse 2s ease infinite}
        @@keyframes ttPulse{0%,100%{box-shadow:0 0 0 0 rgba(255,59,48,.4)}50%{box-shadow:0 0 0 5px rgba(255,59,48,0)}}

        /* WINDOW */
        #tt-win{position:absolute;bottom:84px;right:0;width:400px;background:white;border-radius:24px;box-shadow:0 24px 80px rgba(0,0,0,.18),0 4px 16px rgba(0,0,0,.08);display:flex;flex-direction:column;overflow:hidden;transform-origin:bottom right;transition:all .38s cubic-bezier(.34,1.56,.64,1);transform:scale(0) translateY(20px);opacity:0;pointer-events:none;max-height:calc(100vh - 120px)}
        #tt-win.open{transform:scale(1) translateY(0);opacity:1;pointer-events:all}

        /* HEADER */
        .tt-hdr{background:linear-gradient(150deg,var(--tt-header-start) 0%,var(--tt-primary) 60%,var(--tt-primary-light) 100%);padding:18px 20px 14px;display:flex;align-items:center;gap:14px;flex-shrink:0;position:relative;overflow:hidden}
        .tt-hdr::before{content:'';position:absolute;top:-30px;right:-30px;width:120px;height:120px;background:rgba(255,255,255,.07);border-radius:50%}
        .tt-hdr::after{content:'';position:absolute;bottom:-20px;left:20px;width:80px;height:80px;background:rgba(255,255,255,.05);border-radius:50%}
        .tt-av{width:44px;height:44px;background:rgba(255,255,255,.18);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;position:relative;z-index:1;border:1.5px solid rgba(255,255,255,.25)}
        .tt-hi{flex:1;position:relative;z-index:1}
        .tt-hn{font-family:'Syne',sans-serif;font-weight:800;font-size:16px;color:white;line-height:1.2;letter-spacing:-.2px}
        .tt-hs{font-size:11px;color:rgba(255,255,255,.75);display:flex;align-items:center;gap:5px;margin-top:2px}
        .tt-hs::before{content:'';width:7px;height:7px;background:#7fff7f;border-radius:50%;display:inline-block;animation:ttp 2s infinite;flex-shrink:0}
        @@keyframes ttp{0%,100%{opacity:1}50%{opacity:.3}}
        .tt-cls{background:rgba(255,255,255,.15);border:none;cursor:pointer;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:16px;transition:all .2s;position:relative;z-index:1;flex-shrink:0}
        .tt-cls:hover{background:rgba(255,255,255,.28)}

        /* PROGRESS STEPS */
        .tt-steps{padding:10px 16px;background:#f8f9fa;border-bottom:1px solid #e8e8ed;display:flex;align-items:center;justify-content:center;gap:0;flex-shrink:0}
        .tt-step{display:flex;align-items:center;gap:0}
        .tt-step-dot{width:26px;height:26px;border-radius:50%;border:2px solid #d1d1d6;background:white;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#8e8e93;transition:all .35s;flex-shrink:0}
        .tt-step.done .tt-step-dot{background:var(--tt-primary);border-color:var(--tt-primary);color:white}
        .tt-step.active .tt-step-dot{background:white;border-color:var(--tt-primary);color:var(--tt-primary);box-shadow:0 0 0 3px rgba(var(--tt-primary-rgb),.15)}
        .tt-step-line{width:28px;height:2px;background:#d1d1d6;transition:background .35s}
        .tt-step.done + .tt-step-line,.tt-step.done .tt-step-line,.tt-step-line.done{background:var(--tt-primary)}
        .tt-step-lbl{font-size:8.5px;color:#8e8e93;font-weight:600;text-align:center;margin-top:3px;letter-spacing:.2px;transition:color .35s}
        .tt-step.active .tt-step-lbl,.tt-step.done .tt-step-lbl{color:var(--tt-primary)}
        .tt-step-wrap{display:flex;flex-direction:column;align-items:center;gap:0}

        /* MESSAGES */
        #tt-msgs{flex:1;overflow-y:auto;padding:14px 14px 8px;display:flex;flex-direction:column;gap:8px;scroll-behavior:smooth;min-height:0}
        #tt-msgs::-webkit-scrollbar{width:4px}
        #tt-msgs::-webkit-scrollbar-thumb{background:#e5e5ea;border-radius:2px}
        .tt-row{display:flex;animation:ttIn .28s ease both}
        @@keyframes ttIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
        .tt-row.u{justify-content:flex-end}
        .tt-bbl{max-width:86%;padding:10px 14px;border-radius:18px;font-size:13.5px;line-height:1.58;word-break:break-word}
        .tt-row.u .tt-bbl{background:linear-gradient(135deg,var(--tt-primary),var(--tt-gradient-mid));color:white;border-bottom-right-radius:5px;box-shadow:0 2px 8px rgba(var(--tt-primary-rgb),.25)}
        .tt-row.b .tt-bbl{background:#f0f0f5;color:#1c1c1e;border-bottom-left-radius:5px}
        .tt-typ{display:flex;align-items:center;gap:5px;padding:11px 14px;background:#f0f0f5;border-radius:18px;border-bottom-left-radius:5px;width:fit-content}
        .tt-td{width:7px;height:7px;background:#b0b0ba;border-radius:50%;animation:ttb 1.2s infinite}
        .tt-td:nth-child(2){animation-delay:.2s}.tt-td:nth-child(3){animation-delay:.4s}
        @@keyframes ttb{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-6px)}}
        .tt-ldr{display:flex;align-items:center;gap:10px;padding:10px 14px;background:#f0f0f5;border-radius:18px;border-bottom-left-radius:5px;font-size:13px;color:#8e8e93;width:fit-content}
        .tt-spn{width:16px;height:16px;border:2px solid #e5e5ea;border-top-color:var(--tt-primary);border-radius:50%;animation:tts .7s linear infinite;flex-shrink:0}
        @@keyframes tts{to{transform:rotate(360deg)}}

        /* CARDS */
        .tt-card{background:white;border:1px solid #e5e5ea;border-radius:14px;padding:14px;font-size:13px;box-shadow:0 2px 8px rgba(0,0,0,.04)}
        .tt-ct{font-family:'Syne',sans-serif;font-weight:700;font-size:14px;color:#1c1c1e;margin-bottom:10px;display:flex;align-items:center;gap:6px}
        .tt-dr{display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid #f5f5f7}
        .tt-dr:last-of-type{border-bottom:none}
        .tt-dk{color:#8e8e93;font-size:12px;flex-shrink:0;padding-right:8px}
        .tt-dv{color:#1c1c1e;font-weight:500;font-size:12px;text-align:right;max-width:210px}
        .tt-sb{display:inline-block;padding:3px 10px;border-radius:100px;font-size:11px;font-weight:700;margin:7px 0 4px;letter-spacing:.2px}
        .bs{background:#fff3cd;color:#856404}.bw{background:#d1ecf1;color:#0c5460}.bo{background:#d4edda;color:#155724}.bd{background:#e8f7ea;color:var(--tt-primary-dark)}

        /* TRACKER */
        .tt-trk{display:flex;align-items:flex-start;margin-top:10px}
        .tt-ts{display:flex;flex-direction:column;align-items:center;flex:1;position:relative}
        .tt-ts:not(:last-child)::after{content:'';position:absolute;top:10px;left:50%;right:-50%;height:2px;background:#e5e5ea;z-index:0}
        .tt-ts.done:not(:last-child)::after,.tt-ts.cur:not(:last-child)::after{background:var(--tt-primary)}
        .tt-tdot{width:20px;height:20px;border-radius:50%;background:#e5e5ea;border:2px solid #e5e5ea;display:flex;align-items:center;justify-content:center;font-size:8px;color:#8e8e93;position:relative;z-index:1;margin-bottom:4px;font-weight:700}
        .tt-ts.done .tt-tdot{background:var(--tt-primary);border-color:var(--tt-primary);color:white}
        .tt-ts.cur .tt-tdot{background:white;border-color:var(--tt-primary);color:var(--tt-primary);box-shadow:0 0 0 3px rgba(var(--tt-primary-rgb),.15)}
        .tt-tlbl{font-size:8.5px;color:#48484a;text-align:center;line-height:1.3}
        .tt-ts.done .tt-tlbl,.tt-ts.cur .tt-tlbl{color:var(--tt-primary);font-weight:600}

        /* INFO BOXES */
        .tt-info{background:#e8f7ea;border:1px solid rgba(var(--tt-primary-rgb),.25);border-radius:12px;padding:11px 14px;font-size:12.5px;color:#1c5a28;line-height:1.6;margin:3px 0}
        .tt-warn{background:#fff8ec;border:1px solid rgba(245,158,11,.3);border-radius:12px;padding:11px 14px;font-size:12.5px;color:#5a3a00;line-height:1.6;margin:3px 0}
        .tt-err{background:#fef2f2;border:1px solid rgba(239,68,68,.25);border-radius:12px;padding:11px 14px;font-size:12.5px;color:#7d1f1f;line-height:1.6;margin:3px 0}

        /* QUICK REPLY BUTTONS */
        .tt-qrs{display:flex;flex-wrap:wrap;gap:6px;margin-top:2px;animation:ttIn .26s ease both .1s;opacity:0;animation-fill-mode:both}
        .tt-qr{padding:7px 13px;border:1.5px solid var(--tt-primary);background:white;color:var(--tt-primary);border-radius:100px;font-size:12.5px;font-weight:500;cursor:pointer;transition:all .18s;font-family:'DM Sans',sans-serif;line-height:1.3}
        .tt-qr:hover{background:var(--tt-primary);color:white;box-shadow:0 3px 10px rgba(var(--tt-primary-rgb),.25)}
        .tt-qr:disabled{opacity:.36;cursor:default;pointer-events:none}
        .tt-qr.red{border-color:#dc2626;color:#dc2626}.tt-qr.red:hover{background:#dc2626;color:white}
        .tt-qr.grey{border-color:#8e8e93;color:#8e8e93}.tt-qr.grey:hover{background:#8e8e93;color:white}

        /* OTP CARD */
        .tt-otpcard{background:white;border:1px solid #e5e5ea;border-radius:14px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.04)}
        .tt-otpcard label{display:block;font-size:11px;font-weight:700;color:#8e8e93;text-transform:uppercase;letter-spacing:.6px;margin-bottom:6px}
        .tt-otpcard input{width:100%;border:1.5px solid #e5e5ea;border-radius:10px;padding:10px 13px;font-size:13.5px;font-family:'DM Sans',sans-serif;outline:none;transition:all .2s;background:#fafafa}
        .tt-otpcard input:focus{border-color:var(--tt-primary);background:white;box-shadow:0 0 0 3px rgba(var(--tt-primary-rgb),.1)}
        .tt-otpcard .tt-hint{font-size:11px;color:#8e8e93;margin:6px 0 12px;line-height:1.4}

        /* OTP DIGIT INPUT */
        .tt-otp-digits{display:flex;gap:8px;margin:10px 0}
        .tt-otp-digit{width:40px;height:48px;border:1.5px solid #e5e5ea;border-radius:10px;text-align:center;font-size:22px;font-family:'Syne',sans-serif;font-weight:700;color:#1c1c1e;outline:none;transition:all .2s;background:#fafafa;-moz-appearance:textfield}
        .tt-otp-digit::-webkit-outer-spin-button,.tt-otp-digit::-webkit-inner-spin-button{-webkit-appearance:none}
        .tt-otp-digit:focus{border-color:var(--tt-primary);background:white;box-shadow:0 0 0 3px rgba(var(--tt-primary-rgb),.12)}
        .tt-otp-digit.filled{border-color:var(--tt-primary);background:#f0faf1;color:var(--tt-primary-dark)}
        .tt-otp-digit.error{border-color:#dc2626;background:#fef2f2;animation:ttShake .4s ease}
        @@keyframes ttShake{0%,100%{transform:translateX(0)}25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}

        .tt-btns{display:flex;gap:8px;margin-top:4px}
        .tt-btn-primary{flex:1;padding:10px;background:linear-gradient(135deg,var(--tt-primary),var(--tt-gradient-mid));color:white;border:none;border-radius:10px;font-family:'Syne',sans-serif;font-weight:700;font-size:12px;cursor:pointer;transition:all .2s;letter-spacing:.3px}
        .tt-btn-primary:hover{transform:translateY(-1px);box-shadow:0 4px 14px rgba(var(--tt-primary-rgb),.35)}
        .tt-btn-primary:disabled{opacity:.5;cursor:default;transform:none;box-shadow:none}
        .tt-btn-ghost{padding:10px 14px;background:white;color:#8e8e93;border:1.5px solid #e5e5ea;border-radius:10px;font-size:12px;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .2s;white-space:nowrap}
        .tt-btn-ghost:hover{border-color:#8e8e93;color:#48484a}

        /* RESEND TIMER */
        .tt-resend{font-size:11px;color:#8e8e93;text-align:center;margin-top:8px}
        .tt-resend a{color:var(--tt-primary);cursor:pointer;font-weight:600;text-decoration:none}
        .tt-resend a:hover{text-decoration:underline}

        /* SUMMARY */
        .tt-sum{background:white;border:1px solid #e5e5ea;border-radius:14px;padding:14px;box-shadow:0 2px 8px rgba(0,0,0,.04)}
        .tt-sum-t{font-family:'Syne',sans-serif;font-weight:700;font-size:13px;color:var(--tt-primary);margin-bottom:8px}
        .tt-sr{display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid #f5f5f7}
        .tt-sr:last-child{border-bottom:none;padding-top:7px}
        .tt-sk{color:#8e8e93;font-size:12px}.tt-sv{color:#1c1c1e;font-weight:600;font-size:12px;text-align:right;max-width:200px}
        .tt-svcs{display:flex;flex-wrap:wrap;gap:4px;margin-top:7px}
        .tt-svc{background:#e8f7ea;color:var(--tt-primary-dark);font-size:10px;font-weight:700;padding:3px 9px;border-radius:100px}

        /* VERIFY CARD (identity) */
        .tt-vcard{background:white;border:1px solid #e5e5ea;border-radius:14px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.04)}
        .tt-vcard label{display:block;font-size:11px;font-weight:700;color:#8e8e93;text-transform:uppercase;letter-spacing:.6px;margin-bottom:6px}
        .tt-vcard input{width:100%;border:1.5px solid #e5e5ea;border-radius:10px;padding:10px 13px;font-size:13px;font-family:'DM Sans',sans-serif;outline:none;transition:all .2s;background:#fafafa}
        .tt-vcard input:focus{border-color:var(--tt-primary);background:white;box-shadow:0 0 0 3px rgba(var(--tt-primary-rgb),.1)}
        .tt-vhint{font-size:11px;color:#8e8e93;margin:5px 0 12px;font-style:italic;line-height:1.4}

        /* SECURE BADGE */
        .tt-secure{display:flex;align-items:center;gap:5px;font-size:10.5px;color:#8e8e93;background:#f5f5f7;border-radius:8px;padding:6px 10px;margin-top:8px}
        .tt-secure svg{flex-shrink:0;color:var(--tt-primary)}

        /* INPUT AREA */
        .tt-ia{padding:10px 14px 12px;border-top:1px solid #e8e8ed;display:flex;gap:8px;align-items:center;flex-shrink:0;background:white}
        #tt-inp{flex:1;border:1.5px solid #e5e5ea;border-radius:100px;padding:10px 16px;font-size:13.5px;font-family:'DM Sans',sans-serif;outline:none;transition:all .2s;background:#f5f5f7;color:#1c1c1e}
        #tt-inp:focus{border-color:var(--tt-primary);background:white;box-shadow:0 0 0 3px rgba(var(--tt-primary-rgb),.08)}
        #tt-inp::placeholder{color:#b0b0ba}
        #tt-snd{width:40px;height:40px;background:linear-gradient(135deg,var(--tt-primary),var(--tt-gradient-mid));border:none;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0;box-shadow:0 3px 10px rgba(var(--tt-primary-rgb),.3)}
        #tt-snd:hover{transform:scale(1.08);box-shadow:0 5px 16px rgba(var(--tt-primary-rgb),.4)}
        #tt-snd svg{color:white}
        .tt-foot{text-align:center;font-size:10px;color:#b0b0ba;padding:0 16px 10px;flex-shrink:0}

        @@media(max-width:480px){
          #tt-win{width:calc(100vw - 20px);right:-8px;max-height:80vh}
          #tt-bubble{bottom:18px;right:18px}
        }
        `;
        document.head.appendChild(s);

        /* BUILD WIDGET */
        const wrap=document.createElement('div');
        wrap.id='tt-bubble';
        wrap.innerHTML=`
        <div id="tt-win">
          <div class="tt-hdr">
            <div class="tt-av">🚚</div>
            <div class="tt-hi">
              <div class="tt-hn">TrackIT by Furdeco</div>
              <div class="tt-hs">Online · Secure Delivery Portal</div>
            </div>
            <button class="tt-cls" id="tt-cls" aria-label="Close">✕</button>
          </div>
          <div class="tt-steps" id="tt-steps">
            <div class="tt-step" id="step-ref">
              <div class="tt-step-wrap">
                <div class="tt-step-dot">1</div>
                <div class="tt-step-lbl">Reference</div>
              </div>
            </div>
            <div class="tt-step-line" id="line-1"></div>
            <div class="tt-step" id="step-otp">
              <div class="tt-step-wrap">
                <div class="tt-step-dot">2</div>
                <div class="tt-step-lbl">Verify</div>
              </div>
            </div>
            <div class="tt-step-line" id="line-2"></div>
            <div class="tt-step" id="step-order">
              <div class="tt-step-wrap">
                <div class="tt-step-dot">3</div>
                <div class="tt-step-lbl">Order</div>
              </div>
            </div>
            <div class="tt-step-line" id="line-3"></div>
            <div class="tt-step" id="step-action">
              <div class="tt-step-wrap">
                <div class="tt-step-dot">4</div>
                <div class="tt-step-lbl">Action</div>
              </div>
            </div>
          </div>
          <div id="tt-msgs"></div>
          <div class="tt-ia">
            <input type="text" id="tt-inp" placeholder="Type a message…" autocomplete="off">
            <button id="tt-snd" aria-label="Send">
              <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>
          </div>
          <div class="tt-foot">🔒 Secure &amp; Encrypted · Powered by Furdeco</div>
        </div>
        <button id="tt-toggle" aria-label="Open TrackIT">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <span class="tt-lbl">TrackIT</span>
          <span class="tt-dot">1</span>
        </button>`;
        document.body.appendChild(wrap);

        /* STATE */
        let isOpen=false,started=false;
        let state='welcome'; // welcome→lookup→lookup_pc→otp_choice→otp_email|otp_phone→otp_sending→otp_verify→fetching→action→verify→processing→instructions→done
        let order=null,action=null,pRef=null,pPc=null,pRefType='consignment',otpEmail=null,otpType='email',otpIdentifier=null,otpAttempts=0,resendTimer=null;

        const win2=document.getElementById('tt-win');
        const msgs=document.getElementById('tt-msgs');
        const inp=document.getElementById('tt-inp');

        const RE_G=/^(hi|hello|hey|hiya|howdy|good\s*(morning|afternoon|evening))[\s!?.,]*/i;
        const RE_C=/\b(cancel|exit|quit|stop|back|start over|no thanks)\b/i;
        const RE_H=/\b(human|agent|person|operator|speak to someone|real person|call me)\b/i;

        /* STEP PROGRESS */
        function setStep(name){
          // name: 'ref','otp','order','action'
          const steps=['ref','otp','order','action'];
          const idx=steps.indexOf(name);
          steps.forEach((s,i)=>{
            const el=document.getElementById(`step-${s}`);
            el.className='tt-step'+(i<idx?' done':i===idx?' active':'');
            const line=document.getElementById(`line-${i+1}`);
            if(line)line.className='tt-step-line'+(i<idx?' done':'');
          });
        }

        /* TOGGLE */
        document.getElementById('tt-toggle').onclick=()=>isOpen?closeW():openW();
        document.getElementById('tt-cls').onclick=closeW;

        function openW(){
          isOpen=true;win2.classList.add('open');
          document.querySelector('.tt-dot').style.display='none';
          if(!started){started=true;setTimeout(startChat,440);}
          else setTimeout(()=>inp.focus(),350);
        }
        function closeW(){isOpen=false;win2.classList.remove('open');}

        /* MESSAGE HELPERS */
        function botMsg(html,ms=750){
          const tr=raw(`<div class="tt-row b"><div class="tt-typ"><div class="tt-td"></div><div class="tt-td"></div><div class="tt-td"></div></div></div>`);
          sd();
          return new Promise(r=>setTimeout(()=>{tr.remove();raw(`<div class="tt-row b"><div class="tt-bbl">${html}</div></div>`);sd();r();},ms));
        }
        function userMsg(t){raw(`<div class="tt-row u"><div class="tt-bbl">${xe(t)}</div></div>`);sd();}
        function ldrMsg(l='Connecting…'){const el=raw(`<div class="tt-row b"><div class="tt-ldr"><div class="tt-spn"></div>${l}</div></div>`);sd();return el;}
        function raw(html){const t=document.createElement('div');t.innerHTML=html;const el=t.firstElementChild;msgs.appendChild(el);return el;}
        function addEl(el,ms=0){return new Promise(r=>setTimeout(()=>{msgs.appendChild(el);sd();r();},ms));}
        function qrs(btns,ms=650){
          return new Promise(r=>setTimeout(()=>{
            const div=document.createElement('div');div.className='tt-qrs';
            btns.forEach(b=>{
              const btn=document.createElement('button');
              btn.className='tt-qr'+(b.cls?' '+b.cls:'');
              btn.textContent=b.label;
              btn.onclick=()=>{dQR();b.fn();};
              div.appendChild(btn);
            });
            msgs.appendChild(div);sd();r();
          },ms));
        }
        function dQR(){document.querySelectorAll('.tt-qr').forEach(b=>b.disabled=true);}
        function sd(){setTimeout(()=>msgs.scrollTop=msgs.scrollHeight,60);}

        /* ================================================================
           FLOW
           ================================================================ */

        async function startChat(){
          setStep('ref');
          state='lookup';
          await botMsg(`Hi there! 👋 I'm <strong>TrackIT</strong>, Furdeco's secure delivery assistant.<br><br>How would you like to track your order?`);
          await qrs([
            {label:'📦 Consignment Number',fn:()=>{pRefType='consignment';userMsg('Consignment Number');state='lookup';setStep('ref');botMsg('Got it! Please enter your <strong>consignment number</strong>.'+(CONFIG.DEMO_MODE?'<br><em style="font-size:11px;color:#999">Demo: MD-DEMO-001</em>':''));}},
            {label:'🛒 Order Number',fn:()=>{pRefType='order';userMsg('Order Number');state='lookup';setStep('ref');botMsg('Got it! Please enter your <strong>order number</strong>.');}}
          ]);
          inp.focus();
        }

        function handleInput(){
          const val=inp.value.trim();
          if(!val)return;
          inp.value='';
          if(RE_H.test(val)){userMsg(val);humanHandoff();return;}
          if(RE_C.test(val)&&['otp_verify','verify','instructions'].includes(state)){userMsg(val);cancelFlow();return;}
          userMsg(val);
          if(state==='lookup')s1(val);
          else if(state==='lookup_pc')s2(val);
          else if(state==='otp_choice')botMsg("Please choose <strong>Email</strong> or <strong>Phone</strong> above to receive your code.");
          else if(state==='otp_email')sOtpEmail(val);
          else if(state==='otp_phone')sOtpPhone(val);
          else if(state==='otp_verify')sOtpVerify(val);
          else if(state==='verify')doVerify(val);
          else if(state==='instructions')doInstr(val);
          else if(RE_G.test(val))botMsg("Hello! 😊 Enter your <strong>consignment number</strong> to get started.");
          else botMsg("Enter your <strong>consignment number</strong> or say <em>'talk to a human'</em>.");
        }

        /* STEP 1 — Reference */
        async function s1(val){
          if(RE_G.test(val)){await botMsg("Hello! 😊 Please enter your <strong>consignment number</strong>.");return;}
          pRef=val.toUpperCase().trim();
          state='lookup_pc';
          await botMsg("Got it! And your <strong>delivery postcode</strong>?");
        }

        /* STEP 2 — Postcode */
        async function s2(val){
          pPc=val.toUpperCase().trim();
          setStep('otp');
          state='otp_choice';
          await botMsg(`Thanks! 🔒 To protect your order data, we need to verify your identity.<br><br>How would you like to receive your 6-digit code?`);
          await qrs([
            {label:'📧 Email',fn:()=>{otpType='email';state='otp_email';botMsg("Please enter the <strong>email address</strong> linked to your order, and we'll send you a 6-digit code.");}},
            {label:'📱 Phone',fn:()=>{otpType='phone';state='otp_phone';botMsg("Please enter the <strong>mobile number</strong> linked to your order, and we'll send you a 6-digit code by SMS.");}}
          ],400);
        }

        /* STEP 3a — Collect email */
        async function sOtpEmail(val){
          const emailRe=/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
          if(!emailRe.test(val)){
            await botMsg("That doesn't look like a valid email address. Please try again.");
            return;
          }
          otpEmail=val.toLowerCase().trim();
          otpIdentifier=otpEmail;
          await sendOtpFlow();
        }

        /* STEP 3a — Collect phone */
        async function sOtpPhone(val){
          const digits=(val||'').replace(/\D/g,'');
          if(digits.length<10){
            await botMsg("Please enter a valid mobile number (at least 10 digits).");
            return;
          }
          otpIdentifier=val.trim();
          await sendOtpFlow();
        }

        /* STEP 3b — Send OTP */
        async function sendOtpFlow(){
          state='otp_sending';
          const ldr=ldrMsg('Sending verification code…');
          try{
            await API.sendOtp(otpType,otpIdentifier);
            ldr.remove();
            otpAttempts=0;
            state='otp_verify';
            const masked=otpType==='email'?maskEmail(otpIdentifier):maskPhone(otpIdentifier);
            await botMsg(`✅ A 6-digit code has been sent to <strong>${masked}</strong>.<br><br>Please enter the code below. It expires in <strong>5 minutes</strong>.`+(CONFIG.DEMO_MODE?`<br><em style="font-size:11px;color:#999">Demo code: 123456</em>`:''));
            showOtpInput();
          }catch(e){
            ldr.remove();
            const channel=otpType==='email'?'email':'phone';
            await botMsg(`❌ Failed to send the verification code. Please check your ${channel} and try again.`);
            qrs([
              {label:'🔄 Try Again',fn:()=>{userMsg('Try again');state=otpType==='email'?'otp_email':'otp_phone';botMsg(otpType==='email'?"Please enter your <strong>email address</strong> again:":"Please enter your <strong>mobile number</strong> again:");}},
              {label:'👤 Talk to a Human',fn:()=>{dQR();userMsg('Talk to a human');humanHandoff();}}
            ],400);
          }
        }

        /* OTP INPUT WIDGET */
        function showOtpInput(){
          const el=document.createElement('div');
          el.className='tt-row b';
          el.id='otp-widget';
          el.innerHTML=`
            <div class="tt-bbl" style="max-width:97%;padding:0;background:transparent">
              <div class="tt-otpcard">
                <label>Verification Code</label>
                <div class="tt-otp-digits" id="otp-digits">
                  <input class="tt-otp-digit" type="number" maxlength="1" min="0" max="9" id="otp-d0" autocomplete="off">
                  <input class="tt-otp-digit" type="number" maxlength="1" min="0" max="9" id="otp-d1" autocomplete="off">
                  <input class="tt-otp-digit" type="number" maxlength="1" min="0" max="9" id="otp-d2" autocomplete="off">
                  <input class="tt-otp-digit" type="number" maxlength="1" min="0" max="9" id="otp-d3" autocomplete="off">
                  <input class="tt-otp-digit" type="number" maxlength="1" min="0" max="9" id="otp-d4" autocomplete="off">
                  <input class="tt-otp-digit" type="number" maxlength="1" min="0" max="9" id="otp-d5" autocomplete="off">
                </div>
                <div class="tt-secure">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  Code sent to ${otpType==='email'?maskEmail(otpIdentifier):maskPhone(otpIdentifier)}
                </div>
                <div class="tt-btns" style="margin-top:12px">
                  <button class="tt-btn-primary" id="otp-submit" onclick="window._ttOtpSubmit()">Verify Code →</button>
                  <button class="tt-btn-ghost" onclick="window._ttOtpCancel()">Cancel</button>
                </div>
                <div class="tt-resend" id="otp-resend">Didn't receive it? <a id="otp-resend-btn" onclick="window._ttResend()">Resend</a> <span id="otp-timer"></span></div>
              </div>
            </div>`;
          msgs.appendChild(el);
          sd();

          // Wire up digit navigation
          setTimeout(()=>{
            const digits=[...Array(6)].map((_,i)=>document.getElementById(`otp-d${i}`));
            digits.forEach((d,i)=>{
              d.addEventListener('input',()=>{
                const v=d.value.replace(/[^0-9]/g,'');
                d.value=v.slice(-1);
                d.classList.toggle('filled',!!d.value);
                if(d.value&&i<5)digits[i+1].focus();
                // Auto-submit when all filled
                if(digits.every(x=>x.value))document.getElementById('otp-submit')?.click();
              });
              d.addEventListener('keydown',e=>{
                if(e.key==='Backspace'&&!d.value&&i>0){digits[i-1].focus();digits[i-1].value='';digits[i-1].classList.remove('filled');}
                if(e.key==='Enter')document.getElementById('otp-submit')?.click();
              });
              d.addEventListener('paste',e=>{
                const paste=(e.clipboardData||window.clipboardData).getData('text').replace(/\D/g,'').slice(0,6);
                if(paste.length===6){
                  paste.split('').forEach((c,j)=>{digits[j].value=c;digits[j].classList.add('filled');});
                  setTimeout(()=>document.getElementById('otp-submit')?.click(),100);
                }
                e.preventDefault();
              });
            });
            digits[0].focus();
            startResendTimer(60);
          },200);
        }

        function startResendTimer(secs){
          clearInterval(resendTimer);
          const timerEl=document.getElementById('otp-timer');
          const btn=document.getElementById('otp-resend-btn');
          if(!timerEl||!btn)return;
          let s=secs;
          btn.style.pointerEvents='none';btn.style.opacity='.45';
          timerEl.textContent=`(${s}s)`;
          resendTimer=setInterval(()=>{
            s--;timerEl.textContent=s>0?`(${s}s)`:'';
            if(s<=0){
              clearInterval(resendTimer);
              btn.style.pointerEvents='';btn.style.opacity='';
              timerEl.textContent='';
            }
          },1000);
        }

        window._ttResend=async function(){
          clearInterval(resendTimer);
          const btn=document.getElementById('otp-resend-btn');
          if(btn){btn.style.pointerEvents='none';btn.textContent='Sending…';}
          try{
            await API.sendOtp(otpType,otpIdentifier);
            if(btn){btn.textContent='Resend';}
            startResendTimer(60);
            const digits=[...Array(6)].map((_,i)=>document.getElementById(`otp-d${i}`));
            digits.forEach(d=>{d.value='';d.classList.remove('filled','error');});
            digits[0]?.focus();
            await botMsg("📨 A new code has been sent!",0);
          }catch(e){
            if(btn){btn.textContent='Resend';btn.style.pointerEvents='';}
            await botMsg("❌ Failed to resend code. Please try again.",0);
          }
        };

        window._ttOtpSubmit=function(){
          const digits=[...Array(6)].map((_,i)=>document.getElementById(`otp-d${i}`));
          const code=digits.map(d=>d.value).join('');
          if(code.length<6){digits.find(d=>!d.value)?.focus();return;}
          // Disable widget
          digits.forEach(d=>d.disabled=true);
          document.getElementById('otp-submit').disabled=true;
          document.querySelector('.tt-btn-ghost') && (document.querySelector('.tt-btn-ghost').disabled=true);
          const masked=code.slice(0,3)+'•••';
          userMsg(masked);
          sOtpVerify(code);
        };

        window._ttOtpCancel=function(){
          const digits=[...Array(6)].map((_,i)=>document.getElementById(`otp-d${i}`));
          digits.forEach(d=>d.disabled=true);
          document.getElementById('otp-submit').disabled=true;
          document.querySelector('.tt-btn-ghost') && (document.querySelector('.tt-btn-ghost').disabled=true);
          userMsg('Cancel');
          cancelFlow();
        };

        /* STEP 3c — Verify OTP */
        async function sOtpVerify(code){
          state='otp_checking';
          const ldr=ldrMsg('Verifying code…');
          try{
            await API.verifyOtp(otpType,otpIdentifier,code);
            ldr.remove();
            clearInterval(resendTimer);
            setStep('order');
            await botMsg("✅ <strong>Identity verified!</strong> Loading your order…",400);
            await fetchOrder(pRef,pPc);
          }catch(e){
            ldr.remove();
            otpAttempts++;
            state='otp_verify';
            if(otpAttempts>=3){
              await botMsg("❌ Too many incorrect attempts. Please contact our team for assistance.");
              qrs([{label:'👤 Talk to a Human',fn:()=>{dQR();userMsg('Talk to a human');humanHandoff();}},{label:'🔄 Start Over',fn:()=>{userMsg('Start over');resetLookup();}}],400);
              return;
            }
            // Shake the digit inputs
            const digits=[...Array(6)].map((_,i)=>document.getElementById(`otp-d${i}`));
            digits.forEach(d=>{d.classList.add('error');setTimeout(()=>d.classList.remove('error'),500);});
            digits.forEach(d=>{d.disabled=false;d.value='';d.classList.remove('filled');});
            document.getElementById('otp-submit').disabled=false;
            document.querySelector('.tt-btn-ghost') && (document.querySelector('.tt-btn-ghost').disabled=false);
            await botMsg(`❌ That code is incorrect or has expired. ${3-otpAttempts} attempt${3-otpAttempts!==1?'s':''} remaining.`,0);
            digits[0]?.focus();
          }
        }

        /* FETCH ORDER */
        async function fetchOrder(ref,pc){
          state='fetching';
          const ldr=ldrMsg(CONFIG.DEMO_MODE?'Loading demo order…':'Fetching order…');
          let o;
          try{o=await API.getOrder(ref,pc,pRefType);}
          catch(e){ldr.remove();await showErr(e,'lookup');return;}
          ldr.remove();
          order=o;
          const st=deriveStatus(o.order_steps);
          setStep('order');
          await botMsg(`📦 Here's your order for <strong>${xe(o.carrier_reference)}</strong>:`,400);
          await addEl(buildCard(o,st),150);
          state='action';
          setStep('action');
          await botMsg("What would you like to do?",500);

          const opts=o.order_options;
          const isDel=o.order_steps.delivered==='Yes';
          const isCon=o.confirmed==='True';
          const hasDeliveryDate=!(o.planned_date==='N/A'||!o.planned_date||String(o.planned_date).trim()==='')&&!(o.planned_slot?.start==='TBC'||o.planned_slot?.start==='N/A');

          if(isDel){
            await botMsg("✅ This order has already been <strong>delivered</strong>.",0);
            qrs([{label:'🔍 Track Another',fn:()=>{userMsg('Track another');resetLookup();}},{label:'👤 Talk to a Human',fn:()=>{userMsg('Talk to a human');humanHandoff();}}]);
            return;
          }

            const w=document.createElement('div');w.className='tt-row b';
            await addEl(w,300);
          }

          const btns=[];
          if(hasDeliveryDate&&!isCon)btns.push({label:'✅ Confirm Delivery',fn:()=>pickAction('confirm')});
          if(hasDeliveryDate&&opts.allow_cancel_request==='True')btns.push({label:'❌ Decline Delivery',fn:()=>pickAction('decline'),cls:'red'});
          if(opts.allow_service_request==='True')btns.push({label:'📝 Add Instructions',fn:()=>pickAction('instructions')});
          btns.push({label:'👋 No Action Needed',fn:()=>pickAction('none'),cls:'grey'});
          btns.push({label:'👤 Talk to a Human',fn:()=>{dQR();userMsg('Talk to a human');humanHandoff();}});
          qrs(btns);
        }

        async function pickAction(a){
          action=a;
          const lbl={confirm:'Confirm Delivery',decline:'Decline Delivery',instructions:'Add Instructions',none:'No action needed'};
          userMsg(lbl[a]);
          if(a==='none'){
            const hasDate=!(order.planned_date==='N/A'||!order.planned_date||String(order.planned_date).trim()==='')&&!(order.planned_slot?.start==='TBC'||order.planned_slot?.start==='N/A');
            if(hasDate)await botMsg(`No problem! Your delivery is booked for <strong>${fmtDate(order.planned_date)}</strong>, ${fmtSlot(order.planned_slot)}. 🚚`);
            else await botMsg(`No problem! No delivery date is set yet. You can add instructions or choose a preferred day above — we'll be in touch. 🚚`);
            offerNext(600);return;
          }
          state='verify';
          await botMsg("🔒 One more check — please enter the <strong>mobile number or email</strong> on this order to confirm the action.");
          showVerify();
        }

        function showVerify(){
          const el=document.createElement('div');el.className='tt-row b';
          el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent">
            <div class="tt-vcard">
              <label>Mobile or Email Address</label>
              <input type="text" id="tt-vi" placeholder="e.g. 07700900000 or john@example.com" autocomplete="off">
              <p class="tt-vhint">Must match the contact details on your order.</p>
              <div class="tt-btns">
                <button class="tt-btn-primary" onclick="window._ttV()">Confirm →</button>
                <button class="tt-btn-ghost" onclick="window._ttX()">Cancel</button>
              </div>
            </div>
          </div>`;
          msgs.appendChild(el);sd();
          setTimeout(()=>document.getElementById('tt-vi')?.focus(),300);
        }

        window._ttV=function(){
          const val=document.getElementById('tt-vi')?.value?.trim();
          if(!val)return;
          document.querySelectorAll('#tt-vi,.tt-btn-primary,.tt-btn-ghost').forEach(e=>e.disabled=true);
          const masked=val.includes('@@')?val.replace(/(.{2}).*(@@.*)/,'$1••••$2'):val.replace(/(\d{5})\d+(\d{3})/,'$1•••$2');
          userMsg(masked);doVerify(val);
        };
        window._ttX=function(){
          document.querySelectorAll('#tt-vi,.tt-btn-primary,.tt-btn-ghost').forEach(e=>e.disabled=true);
          userMsg('Cancel');cancelFlow();
        };

        async function doVerify(val){
          if(!verifyIdentity(val,order)){
            await botMsg("That doesn't match our records. ❌<br>Please check and try again.");
            qrs([
              {label:'🔄 Try Again',fn:()=>{state='verify';showVerify();}},
              {label:'✕ Cancel',fn:()=>{dQR();userMsg('Cancel');cancelFlow();},cls:'grey'},
              {label:'👤 Talk to a Human',fn:()=>{dQR();userMsg('Talk to a human');humanHandoff();}}
            ],400);return;
          }
          state='processing';
          await botMsg("✅ <strong>Confirmed!</strong> Processing your request…");
          setTimeout(performAction,700);
        }

        async function performAction(){
          const ref=order.carrier_reference;
          const ldr=ldrMsg(CONFIG.DEMO_MODE?'Updating demo…':'Sending update…');
          try{
            if(action==='confirm'){
              await API.confirmOrder(ref);
              await API.addNote(ref,`Confirmed via TrackIT — ${new Date().toLocaleString('en-GB')}`);
              ldr.remove();state='done';
              await botMsg(`🎉 <strong>Delivery Confirmed!</strong><br><br>Booked for <strong>${fmtDate(order.planned_date)}</strong>, ${fmtSlot(order.planned_slot)}.<br><br>We'll send a reminder the evening before.`);
              await addEl(buildSum('confirm',`${fmtDate(order.planned_date)}, ${fmtSlot(order.planned_slot)}`),350);
            }else if(action==='decline'){
              await API.declineOrder(ref);
              await API.addNote(ref,`Declined via TrackIT — ${new Date().toLocaleString('en-GB')}`);
              ldr.remove();state='done';
              const el=document.createElement('div');el.className='tt-row b';
              el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent"><div class="tt-err">🚫 <strong>Delivery Declined</strong><br>Our team has been notified and will contact you.</div></div>`;
              await botMsg("Your delivery has been <strong>declined</strong>.");
              await addEl(el,250);await addEl(buildSum('decline','Declined — team notified'),250);
            }else if(action==='instructions'){
              ldr.remove();state='instructions';
              const weekOpts=getNextWeekdayOptions();
              await botMsg('Please type your delivery instructions below ');
              qrs([...weekOpts.map(o=>({label:o.label,fn:()=>{dQR();userMsg(o.label);doInstr(o.instruction);}})),{label:'✕ Cancel',fn:()=>{dQR();userMsg('Cancel');cancelFlow();},cls:'grey'}],400);
              return;
            }
            offerNext(550);
          }catch(e){ldr.remove();await showErr(e,'action');}
        }

        async function doInstr(val){
          state='processing';
          const ref=order.carrier_reference;
          const ldr=ldrMsg(CONFIG.DEMO_MODE?'Saving…':'Updating…');
          try{
            await API.updateInstructions(ref,val);
            await API.addNote(ref,`Instructions via TrackIT: "${val}" — ${new Date().toLocaleString('en-GB')}`);
            ldr.remove();state='done';
            await botMsg(`✅ <strong>Instructions Saved!</strong><br><blockquote style="border-left:3px solid var(--tt-primary);padding-left:10px;margin:7px 0;font-style:italic">"${xe(val)}"</blockquote>Our crew will see this before arrival.`);
            await addEl(buildSum('instructions',val),350);
            offerNext(500);
          }catch(e){ldr.remove();await showErr(e,'action');}
        }

        async function showErr(e,ctx){
          console.error('[TrackIT]',e);
          state=ctx==='lookup'?'lookup':'action';
          let msg='';
          if(ctx==='lookup'&&(e.code==='NOT_FOUND'||e.code==='API')){
            msg='No matching consignment found. You recently received an email from Furdeco with regards to your order — you will find your consignment number on this email.';
            if(CONFIG.DEMO_MODE&&e.code==='NOT_FOUND')msg+=`<br><em style="font-size:11px;color:#999">Demo: try MD-DEMO-001 + DL1 1GL</em>`;
          }else if(e.code==='NOT_FOUND')msg=e.message+(CONFIG.DEMO_MODE?`<br><em style="font-size:11px;color:#999">Demo: try MD-DEMO-001 + DL1 1GL</em>`:'');
          else if(e.code==='TIMEOUT')msg='The request took too long. ⏱️ Please try again.';
          else msg='Something went wrong. 😞 Please try again or contact us.';
          const el=document.createElement('div');el.className='tt-row b';
          el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent"><div class="tt-err">❌ ${msg}</div></div>`;
          await addEl(el,0);
          qrs([
            {label:'🔄 Try Again',fn:()=>{dQR();userMsg('Try again');resetLookup();}},
            {label:'👤 Talk to a Human',fn:()=>{dQR();userMsg('Talk to a human');humanHandoff();}}
          ],350);
        }

        async function humanHandoff(){
          state='done';
          await botMsg("Of course! Here are our contact details. 👤");
          const el=document.createElement('div');el.className='tt-row b';
          el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent">
            <div class="tt-info">
              📞 <strong>Phone:</strong> <a href="tel:${CONFIG.SUPPORT_PHONE.replace(/\s/g,'')}" style="color:#1c5a28;font-weight:600">${CONFIG.SUPPORT_PHONE}</a><br>
              📧 <strong>Email:</strong> ${xe(CONFIG.SUPPORT_EMAIL)}<br>
              🕐 <strong>Hours:</strong> ${xe(CONFIG.SUPPORT_HOURS)}<br>
              <span style="font-size:11px;margin-top:4px;display:block">Avg. wait: &lt; 3 minutes</span>
            </div>
          </div>`;
          await addEl(el,300);
          qrs([
            {label:'🤖 Continue with TrackIT',fn:()=>{userMsg('Continue');resetLookup();}},
            {label:'👋 All Done',fn:()=>{dQR();userMsg('All done');goodbye();}}
          ],450);
        }

        async function cancelFlow(){
          await botMsg("No problem! ↩️ Nothing has been changed.");
          resetLookup();
        }

        async function offerNext(ms=800){
          setTimeout(async()=>{
            await botMsg("Is there anything else I can help with?",0);
            qrs([
              {label:'🔍 Track Another Order',fn:()=>{userMsg('Track another');resetLookup();}},
              {label:'👤 Talk to a Human',fn:()=>{dQR();userMsg('Talk to a human');humanHandoff();}},
              {label:'👋 All Done',fn:()=>{dQR();userMsg('All done');goodbye();}}
            ],350);
            state='post_action';
          },ms);
        }

        function resetLookup(){
          order=null;action=null;pRef=null;pPc=null;otpEmail=null;otpType='email';otpIdentifier=null;otpAttempts=0;
          clearInterval(resendTimer);
          state='lookup';setStep('ref');
          botMsg('How would you like to track your order?');qrs([{label:'📦 Consignment Number',fn:()=>{pRefType='consignment';userMsg('Consignment Number');state='lookup';setStep('ref');botMsg('Please enter your <strong>consignment number</strong>.');}},{label:'🛒 Order Number',fn:()=>{pRefType='order';userMsg('Order Number');state='lookup';setStep('ref');botMsg('Please enter your <strong>order number</strong>.');}}]);
        }

        async function goodbye(){
          state='done';
          await botMsg(`Thanks for using <strong>TrackIT</strong>! 👋<br><br>📞 <strong>${CONFIG.SUPPORT_PHONE}</strong><br>📧 <strong>${CONFIG.SUPPORT_EMAIL}</strong><br>🕐 ${CONFIG.SUPPORT_HOURS}<br><br><em>Have a great day – Furdeco 🚚</em>`);
        }

        /* BUILD CARDS */
        function buildCard(o,status){
          const STEPS=[{k:'received',l:'Received'},{k:'scheduled',l:'Scheduled'},{k:'routed',l:'En Route'},{k:'confirmed',l:'Confirmed'},{k:'delivered',l:'Delivered'}];
          const stage=STEPS.findLastIndex(s=>o.order_steps[s.k]==='Yes');
          let trk='<div class="tt-trk">';
          STEPS.forEach((s,i)=>{
            const done=o.order_steps[s.k]==='Yes';const cur=i===stage&&done;
            trk+=`<div class="tt-ts ${done?(cur?'cur':'done'):''}"><div class="tt-tdot">${done?(cur?'●':'✓'):''}</div><div class="tt-tlbl">${s.l}</div></div>`;
          });
          trk+='</div>';
          const prods=(o.products||[]).slice(0,2).map(p=>`<div class="tt-dr"><span class="tt-dk">${xe(p.part)}</span><span class="tt-dv">${xe(p.description)}</span></div>`).join('');
          const svcs=[o.services?.service_level,o.services?.delivery_point].filter(v=>v&&v!=='N/A');
          const svcHTML=svcs.length?`<div class="tt-svcs">${svcs.map(s=>`<span class="tt-svc">${xe(s)}</span>`).join('')}</div>`:'';
          const cb=o.confirmed==='True'?`<span style="font-size:10px;color:var(--tt-primary-dark);font-weight:700;margin-left:6px">✓ Confirmed</span>`:'';
          const el=document.createElement('div');el.className='tt-row b';
          el.innerHTML=`<div class="tt-bbl" style="max-width:97%;padding:0;background:transparent">
            <div class="tt-card">
              <div class="tt-ct">📦 Order Details</div>
              <div class="tt-dr"><span class="tt-dk">Consignment</span><span class="tt-dv">${xe(o.carrier_reference)}</span></div>
              <div class="tt-dr"><span class="tt-dk">Order No.</span><span class="tt-dv">${xe(o.order_number)}</span></div>
              <div class="tt-dr"><span class="tt-dk">Retailer</span><span class="tt-dv">${xe(o.sender_company)}</span></div>
              <div class="tt-dr"><span class="tt-dk">Recipient</span><span class="tt-dv">${xe(o.recipient)}</span></div>
              <div class="tt-dr"><span class="tt-dk">Address</span><span class="tt-dv">${xe(o.address)}, ${xe(o.postcode)}</span></div>
              ${prods}
              <div class="tt-dr" style="margin-top:5px"><span class="tt-dk">Date</span><span class="tt-dv">🗓 ${fmtDate(o.planned_date)}${cb}</span></div>
              <div class="tt-dr"><span class="tt-dk">Slot</span><span class="tt-dv">🕐 ${fmtSlot(o.planned_slot)}</span></div>
              <span class="tt-sb ${status.key}">${xe(status.label)}</span>
              ${svcHTML}${trk}
            </div>
          </div>`;
          return el;
        }

        function buildSum(a,detail){
          const lbl={confirm:'✅ Confirmed',decline:'❌ Declined',instructions:'📝 Instructions Added'};
          const el=document.createElement('div');el.className='tt-row b';
          el.innerHTML=`<div class="tt-bbl" style="max-width:97%;padding:0;background:transparent">
            <div class="tt-sum">
              <div class="tt-sum-t">Session Summary</div>
              <div class="tt-sr"><span class="tt-sk">Consignment</span><span class="tt-sv">${xe(order?.carrier_reference||'–')}</span></div>
              <div class="tt-sr"><span class="tt-sk">Action</span><span class="tt-sv">${lbl[a]||a}</span></div>
              <div class="tt-sr"><span class="tt-sk">Detail</span><span class="tt-sv">${xe(detail)}</span></div>
              <div class="tt-sr"><span class="tt-sk">Time</span><span class="tt-sv">${new Date().toLocaleString('en-GB')}</span></div>
            </div>
          </div>`;
          return el;
        }

        /* EVENT LISTENERS */
        document.getElementById('tt-snd').onclick=handleInput;
        document.getElementById('tt-inp').addEventListener('keydown',e=>{if(e.key==='Enter')handleInput();});
    </script>
</body>
</html>
