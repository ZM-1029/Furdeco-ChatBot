    <button class="tt-cls" id="tt-cls">✕</button>
  </div>
  <div class="tt-crumb" id="tt-crumb"><span class="ac">Track Order</span></div>
  <div id="tt-msgs"></div>
  <div class="tt-ia">
    <input type="text" id="tt-inp" placeholder="Type a message…" autocomplete="off">
    <button id="tt-snd"><svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg></button>
  </div>
  <div class="tt-foot">Powered by zouma.ai · Secure &amp; Encrypted</div>
</div>
<button id="tt-toggle">
  <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
  <span class="tt-lbl">TrackIT</span>
  <span class="tt-dot">1</span>
</button>`;
document.body.appendChild(wrap);

/* STATE */
let generatedOtp = null;
let otpEmail = null;
let isOpen=false,started=false,state='welcome',order=null,action=null,pRef=null,pPc=null;
const win2=document.getElementById('tt-win'),msgs=document.getElementById('tt-msgs'),inp=document.getElementById('tt-inp'),crumb=document.getElementById('tt-crumb');
const RE_G=/^(hi|hello|hey|hiya|howdy|good\s*(morning|afternoon|evening))[\s!?.,]*/i;
const RE_C=/\b(cancel|exit|quit|stop|back|start over|no thanks)\b/i;
const RE_H=/\b(human|agent|person|operator|speak to someone|real person|call me)\b/i;
const CM={welcome:['Track Order'],lookup:['Track Order'],lookup_pc:['Track Order'],fetching:['Track Order','Looking Up…'],action:['Track Order','Choose Action'],verify:['Track Order','Verify Identity'],processing:['Track Order','Processing…'],instructions:['Track Order','Add Instructions'],done:['Track Order','Complete']};
function setCrumb(s){const pts=CM[s]||CM.lookup;crumb.innerHTML=pts.map((p,i)=>`<span class="${i===pts.length-1?'ac':''}">${p}</span>`+(i<pts.length-1?'<span style="color:#e5e5ea;margin:0 2px">›</span>':'')).join('');}
document.getElementById('tt-toggle').onclick=()=>isOpen?closeW():openW();
document.getElementById('tt-cls').onclick=closeW;
function openW(){isOpen=true;win2.classList.add('open');document.querySelector('.tt-dot').style.display='none';if(!started){started=true;setTimeout(startChat,440);}else setTimeout(()=>inp.focus(),350);}
function closeW(){isOpen=false;win2.classList.remove('open');}
function botMsg(html,ms=750){const tr=raw(`<div class="tt-row b"><div class="tt-typ"><div class="tt-td"></div><div class="tt-td"></div><div class="tt-td"></div></div></div>`);sd();return new Promise(r=>setTimeout(()=>{tr.remove();raw(`<div class="tt-row b"><div class="tt-bbl">${html}</div></div>`);sd();r();},ms));}
function userMsg(t){raw(`<div class="tt-row u"><div class="tt-bbl">${xe(t)}</div></div>`);sd();}
function ldrMsg(l='Connecting…'){const el=raw(`<div class="tt-row b"><div class="tt-ldr"><div class="tt-spn"></div>${l}</div></div>`);sd();return el;}
function raw(html){const t=document.createElement('div');t.innerHTML=html;const el=t.firstElementChild;msgs.appendChild(el);return el;}
function addEl(el,ms=0){return new Promise(r=>setTimeout(()=>{msgs.appendChild(el);sd();r();},ms));}
function qrs(btns,ms=650){return new Promise(r=>setTimeout(()=>{const div=document.createElement('div');div.className='tt-qrs';btns.forEach(b=>{const btn=document.createElement('button');btn.className='tt-qr'+(b.cls?' '+b.cls:'');btn.textContent=b.label;btn.onclick=()=>{dQR();b.fn();};div.appendChild(btn);});msgs.appendChild(div);sd();r();},ms));}
function dQR(){document.querySelectorAll('.tt-qr').forEach(b=>b.disabled=true);}
function sd(){setTimeout(()=>msgs.scrollTop=msgs.scrollHeight,60);}
async function startChat(){setCrumb('lookup');state='lookup';await botMsg(`Hi there! 👋 I'm <strong>TrackIT</strong>, Furdeco's delivery assistant.<br><br>I can help you <strong>track your order</strong>, confirm your delivery slot, decline it, or add delivery instructions.<br><br>Please enter your <strong>consignment number</strong> to get started.`+(CONFIG.DEMO_MODE?`<br><em style="font-size:11px;color:#999">Demo: MD-DEMO-001 + DL1 1GL</em>`:''));inp.focus();}
function handleInput(){const val=inp.value.trim();if(!val)return;inp.value='';if(RE_H.test(val)){userMsg(val);humanHandoff();return;}if(RE_C.test(val)&&['verify','instructions'].includes(state)){userMsg(val);cancelFlow();return;}userMsg(val);if(state==='lookup')s1(val);else if(state==='lookup_pc')s2(val);else if(state==='verify')doVerify(val);else if(state==='instructions')doInstr(val);else if(RE_G.test(val))botMsg("Hello! 😊 Enter your <strong>consignment number</strong> to get started.");else botMsg("Enter your <strong>consignment number</strong> or say <em>'talk to a human'</em>.");}
async function s1(val){if(RE_G.test(val)){await botMsg("Hello! 😊 Please enter your <strong>consignment number</strong>.");return;}pRef=val.toUpperCase().trim();state='lookup_pc';setCrumb('lookup_pc');await botMsg("Got it! And your <strong>delivery postcode</strong>?");}
async function s2(val){pPc=val.toUpperCase().trim();await fetchOrder(pRef,pPc);}
async function fetchOrder(ref,pc){state='fetching';setCrumb('fetching');const ldr=ldrMsg(CONFIG.DEMO_MODE?'Loading demo order…':'Calling Multidrop API…');let o;try{o=await API.getOrder(ref,pc);}catch(e){ldr.remove();await showErr(e,'lookup');return;}ldr.remove();order=o;const st=deriveStatus(o.order_steps);await botMsg(`Found it! Here's your order for <strong>${xe(o.carrier_reference)}</strong>:`,400);await addEl(buildCard(o,st),150);state='action';setCrumb('action');await botMsg("What would you like to do?",500);
const opts=o.order_options;const isDel=o.order_steps.delivered==='Yes';const isOut=o.order_steps.routed==='Yes'&&!isDel;const isCon=o.confirmed==='True';
if(isDel){await botMsg("✅ This order has already been <strong>delivered</strong>.",0);qrs([{label:'🔍 Track Another',fn:()=>{userMsg('Track another');resetLookup();}},{label:'👤 Talk to a Human',fn:()=>{userMsg('Talk to a human');humanHandoff();}}]);return;}
if(isOut){const w=document.createElement('div');w.className='tt-row b';w.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent"><div class="tt-warn">⚠️ Your order is <strong>out for delivery today</strong>. Confirm/Decline is unavailable at this stage.</div></div>`;await addEl(w,300);}
const btns=[];
if(!isOut&&!isCon)btns.push({label:'✅ Confirm Delivery',fn:()=>pickAction('confirm')});
if(opts.allow_cancel_request==='True'&&!isOut)btns.push({label:'❌ Decline Delivery',fn:()=>pickAction('decline'),cls:'red'});
if(opts.allow_service_request==='True')btns.push({label:'📝 Add Instructions',fn:()=>pickAction('instructions')});
btns.push({label:'👋 No Action Needed',fn:()=>pickAction('none'),cls:'grey'});
btns.push({label:'👤 Talk to a Human',fn:()=>{dQR();userMsg('Talk to a human');humanHandoff();}});
qrs(btns);}
async function pickAction(a){action=a;const lbl={confirm:'Confirm Delivery',decline:'Decline Delivery',instructions:'Add Instructions',none:'No action needed'};userMsg(lbl[a]);if(a==='none'){await botMsg(`No problem! Your delivery is booked for <strong>${fmtDate(order.planned_date)}</strong>, ${fmtSlot(order.planned_slot)}. 🚚`);offerNext(600);return;}state='verify';setCrumb('verify');await botMsg("To protect your account I need to verify your identity. 🔒<br><br>Please enter the <strong>mobile number</strong> or <strong>email address</strong> linked to this order.");showVerify();}
function showVerify(){const el=document.createElement('div');el.className='tt-row b';el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent"><div class="tt-vcard"><label>Mobile or Email Address</label><input type="text" id="tt-vi" placeholder="e.g. 07700900000 or john@example.com" autocomplete="off"><p class="tt-vhint">Must match the contact details on your order.</p><div class="tt-vbtns"><button class="tt-vsub" onclick="window._ttV()">Verify →</button><button class="tt-vcan" onclick="window._ttX()">Cancel</button></div></div></div>`;msgs.appendChild(el);sd();setTimeout(()=>document.getElementById('tt-vi')?.focus(),300);}
window._ttV=function(){const val=document.getElementById('tt-vi')?.value?.trim();if(!val)return;document.querySelectorAll('.tt-vsub,.tt-vcan,#tt-vi').forEach(e=>e.disabled=true);const masked=val.includes('@@')?val.replace(/(.{2}).*(@@.*)/,'$1••••$2'):val.replace(/(\d{5})\d+(\d{3})/,'$1•••$2');userMsg(masked);doVerify(val);};
window._ttX=function(){document.querySelectorAll('.tt-vsub,.tt-vcan,#tt-vi').forEach(e=>e.disabled=true);userMsg('Cancel');cancelFlow();};
async function doVerify(val){if(!verifyIdentity(val,order)){await botMsg("That doesn't match our records. ❌<br>Please check and try again.");qrs([{label:'🔄 Try Again',fn:()=>{state='verify';showVerify();}},{label:'✕ Cancel',fn:()=>{dQR();userMsg('Cancel');cancelFlow();},cls:'grey'},{label:'👤 Talk to a Human',fn:()=>{dQR();userMsg('Talk to a human');humanHandoff();}}],400);return;}state='processing';setCrumb('processing');await botMsg("✅ <strong>Identity verified!</strong> Processing…");setTimeout(performAction,700);}
async function performAction(){const ref=order.carrier_reference;const ldr=ldrMsg(CONFIG.DEMO_MODE?'Updating demo…':'Sending to Multidrop…');try{if(action==='confirm'){await API.confirmOrder(ref);await API.addNote(ref,`Confirmed via TrackIT — ${new Date().toLocaleString('en-GB')}`);ldr.remove();state='done';setCrumb('done');await botMsg(`🎉 <strong>Delivery Confirmed!</strong><br><br>Your order is confirmed for <strong>${fmtDate(order.planned_date)}</strong>, ${fmtSlot(order.planned_slot)}.<br><br>We'll send a reminder the evening before.`);await addEl(buildSum('confirm',`${fmtDate(order.planned_date)}, ${fmtSlot(order.planned_slot)}`),350);}else if(action==='decline'){await API.declineOrder(ref);await API.addNote(ref,`Declined via TrackIT — ${new Date().toLocaleString('en-GB')}`);ldr.remove();state='done';setCrumb('done');const el=document.createElement('div');el.className='tt-row b';el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent"><div class="tt-err">🚫 <strong>Delivery Declined</strong><br>Our team has been notified and will be in touch.</div></div>`;await botMsg("Your delivery has been <strong>declined</strong>.");await addEl(el,250);await addEl(buildSum('decline','Declined — team notified'),250);}else if(action==='instructions'){ldr.remove();state='instructions';setCrumb('instructions');await botMsg('Please type your delivery instructions below 📝<br><em style="font-size:11px;color:#999">e.g. "Leave in garage", "Ring bell twice"</em>');qrs([{label:'✕ Cancel',fn:()=>{dQR();userMsg('Cancel');cancelFlow();},cls:'grey'}],400);return;}offerNext(550);}catch(e){ldr.remove();await showErr(e,'action');}}
async function doInstr(val){state='processing';setCrumb('processing');const ref=order.carrier_reference;const ldr=ldrMsg(CONFIG.DEMO_MODE?'Saving…':'Updating Multidrop…');try{await API.updateInstructions(ref,val);await API.addNote(ref,`Instructions via TrackIT: "${val}" — ${new Date().toLocaleString('en-GB')}`);ldr.remove();state='done';setCrumb('done');await botMsg(`✅ <strong>Instructions Saved!</strong><br><blockquote style="border-left:3px solid #3AB54A;padding-left:10px;margin:7px 0;font-style:italic">"${xe(val)}"</blockquote>Our crew will see this before arrival.`);await addEl(buildSum('instructions',val),350);offerNext(500);}catch(e){ldr.remove();await showErr(e,'action');}}
async function showErr(e,ctx){console.error('[TrackIT]',e);state=ctx==='lookup'?'lookup':'action';let msg='';if(e.code==='NOT_FOUND')msg=e.message+(CONFIG.DEMO_MODE?`<br><em style="font-size:11px;color:#999">Demo: try MD-DEMO-001 + DL1 1GL</em>`:'');else if(e.code==='TIMEOUT')msg='The request timed out. ⏱️ Please try again.';else msg='Something went wrong. 😞 Please try again or contact us.';const el=document.createElement('div');el.className='tt-row b';el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent"><div class="tt-err">❌ ${msg}</div></div>`;await addEl(el,0);qrs([{label:'🔄 Try Again',fn:()=>{dQR();userMsg('Try again');resetLookup();}},{label:'👤 Talk to a Human',fn:()=>{dQR();userMsg('Talk to a human');humanHandoff();}}],350);}
async function humanHandoff(){state='done';setCrumb('done');await botMsg("Of course! Here are our contact details. 👤");const el=document.createElement('div');el.className='tt-row b';el.innerHTML=`<div class="tt-bbl" style="max-width:96%;padding:0;background:transparent"><div class="tt-info">📞 <strong>Phone:</strong> <a href="tel:${CONFIG.SUPPORT_PHONE.replace(/\s/g,'')}" style="color:#1c5a28;font-weight:600">${CONFIG.SUPPORT_PHONE}</a><br>📧 <strong>Email:</strong> ${xe(CONFIG.SUPPORT_EMAIL)}<br>🕐 <strong>Hours:</strong> ${xe(CONFIG.SUPPORT_HOURS)}<br><span style="font-size:11px;margin-top:4px;display:block">Avg. wait: &lt; 3 minutes</span></div></div>`;await addEl(el,300);qrs([{label:'🤖 Continue with TrackIT',fn:()=>{userMsg('Continue');resetLookup();}},{label:'👋 All Done',fn:()=>{dQR();userMsg('All done');goodbye();}}],450);}
async function cancelFlow(){await botMsg("No problem! ↩️ Your order hasn't been changed.");resetLookup();}
async function offerNext(ms=800){setTimeout(async()=>{setCrumb('done');await botMsg("Is there anything else I can help with?",0);qrs([{label:'🔍 Track Another Order',fn:()=>{userMsg('Track another');resetLookup();}},{label:'👤 Talk to a Human',fn:()=>{dQR();userMsg('Talk to a human');humanHandoff();}},{label:'👋 All Done',fn:()=>{dQR();userMsg('All done');goodbye();}}],350);state='post_action';},ms);}
function resetLookup(){order=null;action=null;pRef=null;pPc=null;state='lookup';setCrumb('lookup');botMsg("Please enter your <strong>consignment number</strong> to look up another order:");}
async function goodbye(){state='done';setCrumb('done');await botMsg(`Thanks for using <strong>TrackIT</strong>! 👋<br><br>📞 <strong>${CONFIG.SUPPORT_PHONE}</strong><br>📧 <strong>${CONFIG.SUPPORT_EMAIL}</strong><br>🕐 ${CONFIG.SUPPORT_HOURS}<br><br><em>Have a great day – Furdeco 🚚</em>`);}
function buildCard(o,status){const STEPS=[{k:'received',l:'Received'},{k:'scheduled',l:'Scheduled'},{k:'routed',l:'En Route'},{k:'confirmed',l:'Confirmed'},{k:'delivered',l:'Delivered'}];const stage=STEPS.findLastIndex(s=>o.order_steps[s.k]==='Yes');let trk='<div class="tt-trk">';STEPS.forEach((s,i)=>{const done=o.order_steps[s.k]==='Yes';const cur=i===stage&&done;trk+=`<div class="tt-ts ${done?(cur?'cur':'done'):''}"><div class="tt-tdot">${done?(cur?'●':'✓'):''}</div><div class="tt-tlbl">${s.l}</div></div>`;});trk+='</div>';const prods=(o.products||[]).slice(0,2).map(p=>`<div class="tt-dr"><span class="tt-dk">${xe(p.part)}</span><span class="tt-dv">${xe(p.description)}</span></div>`).join('');const svcs=[o.services?.service_level,o.services?.delivery_point].filter(v=>v&&v!=='N/A');const svcHTML=svcs.length?`<div class="tt-svcs">${svcs.map(s=>`<span class="tt-svc">${xe(s)}</span>`).join('')}</div>`:'';const cb=o.confirmed==='True'?`<span style="font-size:10px;color:#2a8f38;font-weight:600;margin-left:6px">✓ Confirmed</span>`:'';const el=document.createElement('div');el.className='tt-row b';el.innerHTML=`<div class="tt-bbl" style="max-width:97%;padding:0;background:transparent"><div class="tt-card"><div class="tt-ct">📦 Order Details</div><div class="tt-dr"><span class="tt-dk">Consignment</span><span class="tt-dv">${xe(o.carrier_reference)}</span></div><div class="tt-dr"><span class="tt-dk">Order No.</span><span class="tt-dv">${xe(o.order_number)}</span></div><div class="tt-dr"><span class="tt-dk">Retailer</span><span class="tt-dv">${xe(o.sender_company)}</span></div><div class="tt-dr"><span class="tt-dk">Recipient</span><span class="tt-dv">${xe(o.recipient)}</span></div><div class="tt-dr"><span class="tt-dk">Address</span><span class="tt-dv">${xe(o.address)}, ${xe(o.postcode)}</span></div>${prods}<div class="tt-dr" style="margin-top:5px"><span class="tt-dk">Date</span><span class="tt-dv">🗓 ${fmtDate(o.planned_date)}${cb}</span></div><div class="tt-dr"><span class="tt-dk">Slot</span><span class="tt-dv">🕐 ${fmtSlot(o.planned_slot)}</span></div><span class="tt-sb ${status.key}">${xe(status.label)}</span>${svcHTML}${trk}</div></div>`;return el;}
function buildSum(a,detail){const lbl={confirm:'✅ Confirmed',decline:'❌ Declined',instructions:'📝 Instructions Added'};const el=document.createElement('div');el.className='tt-row b';el.innerHTML=`<div class="tt-bbl" style="max-width:97%;padding:0;background:transparent"><div class="tt-sum"><div class="tt-sum-t">Session Summary</div><div class="tt-sr"><span class="tt-sk">Consignment</span><span class="tt-sv">${xe(order?.carrier_reference||'–')}</span></div><div class="tt-sr"><span class="tt-sk">Action</span><span class="tt-sv">${lbl[a]||a}</span></div><div class="tt-sr"><span class="tt-sk">Detail</span><span class="tt-sv">${xe(detail)}</span></div><div class="tt-sr"><span class="tt-sk">Time</span><span class="tt-sv">${new Date().toLocaleString('en-GB')}</span></div></div></div>`;return el;}
document.getElementById('tt-snd').onclick=handleInput;
document.getElementById('tt-inp').addEventListener('keydown',e=>{if(e.key==='Enter')handleInput();});
</script>
</body>
</html>